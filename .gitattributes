# Line endings.
#
# This repository builds a Linux operating system image. Shell hooks, the
# Openbox autostart, the Python agent and installer, the live-build automation
# scripts and the systemd units are all copied verbatim into a Debian rootfs and
# executed there. A CRLF line ending in any of them is not cosmetic: the shell
# reports `$'\r': command not found` and the script dies, and a `#!/usr/bin/env
# python3\r` shebang fails to resolve at all.
#
# Windows checkouts default to core.autocrlf=true, which rewrote exactly these
# files on checkout. Everything below pins them to LF regardless of platform.
* text=auto eol=lf

# Executables and config that end up inside the image or drive the build.
*.sh            text eol=lf
*.py            text eol=lf
*.hook.chroot   text eol=lf
*.hook.binary   text eol=lf
*.service       text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.list.chroot   text eol=lf
*.pin           text eol=lf
*.json          text eol=lf
*.js            text eol=lf
*.ts            text eol=lf
*.html          text eol=lf
*.xml           text eol=lf
*.sql           text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf

# Extensionless scripts that are executed inside the image.
distro-builder/auto/*                                       text eol=lf
distro-builder/config/includes.chroot/etc/openbox/autostart text eol=lf
distro-builder/config/includes.chroot/usr/local/bin/*       text eol=lf
distro-builder/config/binary                                text eol=lf
distro-builder/config/bootstrap                             text eol=lf
distro-builder/config/chroot                                text eol=lf
distro-builder/config/common                                text eol=lf
distro-builder/config/source                                text eol=lf

# Binary assets must never be touched.
*.png  binary
*.jpg  binary
*.iso  binary
*.img  binary
*.pf2  binary

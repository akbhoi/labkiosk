# Build context exclusions for the containerized ISO builder.
#
# The Dockerfile does `COPY . /build/`, so anything left here is shipped into
# the image. Without this file the context carried the live-build working tree
# and every previously built ISO -- well over a gigabyte of data that the
# container regenerates from scratch anyway.

# live-build working directories and outputs. `lb clean --purge` + `lb build`
# recreate all of these inside the container.
.build/
cache/
chroot/
chroot.packages.*
local/
binary/
out/
*.iso
*.iso.sha256
*.iso.zsync
*.img
*.list.chroot.installed
*.packages
live-image-*

# Generated by `lb config` from auto/config at build time. These are gitignored
# for the same reason: a stale copy silently overrides auto/config. One of them
# still carried the `quiet loglevel=3` bootappend that caused the black-screen
# boot deadlock, so it must not reach the container.
config/binary
config/bootstrap
config/chroot
config/common
config/source
config/package-lists/live.list.chroot
config/hooks/live/0010-disable-kexec-tools.hook.chroot
config/hooks/live/0050-disable-sysvinit-tmpfs.hook.chroot
config/hooks/normal/

# Python bytecode. Debian 12 ships CPython 3.11; any .pyc built on the host is
# for the wrong interpreter and would be dead weight inside the image.
__pycache__/
*.py[cod]

# Documentation and editor noise: not needed to build an ISO.
*.md
.git/
.gitignore
.idea/
.vscode/
*.swp
*~

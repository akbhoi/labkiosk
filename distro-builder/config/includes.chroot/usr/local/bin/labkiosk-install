#!/usr/bin/env python3
"""
Lab Kiosk OS - Automated Local Disk Installer
Installs the running Lab Kiosk OS to an internal hard drive, SSD, or NVMe disk.
"""

import sys
import os
import errno
import json
import subprocess
import time
import shutil
import re
import stat
import secrets

STATUS_FILE = "/tmp/labkiosk-install-status.json"

# Whole-disk device nodes this installer will write to. The agent applies the
# same check before calling out (TARGET_DISK_PATTERN in
# /opt/labkiosk/agent/agent.py), but the agent is not the only caller:
# /etc/sudoers.d/50-labkiosk-install lets the kiosk user run this binary
# directly with NOPASSWD, so the argument is re-validated here rather than
# trusted. Keep the two patterns identical.
TARGET_DISK_PATTERN = re.compile(r"^/dev/(sd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)\Z")
# One partition of such a disk, which an install beside another system may
# replace. Kept identical to REPLACE_PARTITION_PATTERN in agent.py.
PARTITION_PATTERN = re.compile(
    r"^/dev/(sd[a-z][0-9]{1,3}|vd[a-z][0-9]{1,3}|nvme[0-9]+n[0-9]+p[0-9]{1,3}|mmcblk[0-9]+p[0-9]{1,3})\Z"
)

# A grub-mkpasswd-pbkdf2 digest: grub.pbkdf2.sha512.<rounds>.<salt hex>.<hash hex>.
# Only the digest ever reaches this program -- the setup wizard derives it in the
# browser with WebCrypto, so the plaintext boot-menu password is never sent over
# the agent's API, never reaches a process argument, and is never written to disk.
GRUB_PBKDF2_PATTERN = re.compile(r"^grub\.pbkdf2\.sha512\.[0-9]+\.[0-9A-Fa-f]+\.[0-9A-Fa-f]+\Z")

# The installed disk is an image store (docs/OTA_UPDATES.md section 5.1): the
# live medium's squashfs, kernel and initrd are copied to images/<version>/ on
# LABKIOSK_ROOT and booted through live-boot, exactly as the ISO boots them.
LIVE_IMAGE_DIRS = ("/run/live/medium/live", "/lib/live/mount/medium/live")
IMAGE_FILES = ("vmlinuz", "initrd.img", "filesystem.squashfs")
IMAGE_COPY_CHUNK = 8 * 1024 * 1024
IMAGE_VERSION_FILE = "/usr/share/labkiosk/version"
# Kept identical to VERSION_PATTERN in /usr/local/sbin/labkiosk-boot-slots.
IMAGE_VERSION_PATTERN = re.compile(r"^[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}(?:-[0-9A-Za-z.]{1,32})?\Z")
GRUB_CFG_TEMPLATE = "/usr/share/labkiosk/boot/grub.cfg"
GRUB_PASSWORD_FILE_NAME = "labkiosk-password.cfg"
# The data partition's UUID, for grub.cfg to pass as labkiosk.data=<uuid>.
DATA_ID_FILE_NAME = "labkiosk-data.cfg"
# The swap partition's GPT PARTUUID, for grub.cfg to pass as labkiosk.swap=<id>.
SWAP_ID_FILE_NAME = "labkiosk-swap.cfg"
# Behind compressed RAM, which is the first swap; see labkiosk-swap.
SWAP_PARTITION_MIB = 1024
# The workstation's hostname, for grub.cfg to pass as labkiosk.hostname=<name>
# (labkiosk-hostname sets it at every boot). One DNS label, lowercase.
HOSTNAME_FILE_NAME = "labkiosk-hostname.cfg"
HOSTNAME_PATTERN = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z")
HOSTNAME_PREFIX = "labkiosk-"
# The data partition's LUKS2 container, for grub.cfg to pass as
# labkiosk.datacrypt=<uuid> (labkiosk-data-unlock opens it with the TPM).
# Written only on a machine with a TPM 2.0 chip.
DATA_CRYPT_FILE_NAME = "labkiosk-datacrypt.cfg"
# The one-time key the first installed boot seals to the TPM, then destroys.
# Kept identical to FIRST_BOOT_KEY in /usr/local/sbin/labkiosk-data-unlock.
FIRST_BOOT_KEY_FILE_NAME = "labkiosk-data.key"
DATA_MAPPER_NAME = "labkiosk-data-install"
TPM_CLASS_DIR = "/sys/class/tpm"
TPM_DEVICE = "/dev/tpmrm0"
# What mkfs.ext4 writes; grub.cfg and labkiosk-data-generator accept only this.
FS_UUID_PATTERN = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\Z")
BOOT_SLOTS_HELPER = "/usr/local/sbin/labkiosk-boot-slots"
TARGET_ROOT_MOUNT = "/mnt/target_kiosk"
TARGET_ESP_MOUNT = "/mnt/target_kiosk_esp"
TARGET_DATA_MOUNT = "/mnt/target_kiosk_data"
# Two system images side by side -- the running one and an update or the one
# kept for rollback -- at about 720 MiB each today, with room for them to grow
# (docs/OTA_UPDATES.md section 12 asks for 8 GB). Counted in GiB so that a
# drive sold as "8 GB" (8 000 000 000 bytes, or an eMMC a little under that)
# still qualifies.
MIN_DISK_BYTES = 7 * 1024 * 1024 * 1024
# On the kernel command line of every installed system (the boot menu adds it).
INSTALLED_ARG = "labkiosk.installed=1"
# On the command line of a workstation started over the network, which is
# never installed to a drive. Kept identical to NETBOOT_KERNEL_ARG in agent.py.
NETBOOT_ARG = "labkiosk.netboot=1"

# Installing beside another system (dual boot): UEFI and GPT only. Lab Kiosk
# takes free space, or one partition the administrator gives up, and leaves
# every other partition alone. Its boot loader goes into its own folder on the
# disk's existing EFI system partition, and the firmware gets its own boot
# entry, first in the boot order; the other system is chosen from the
# firmware's boot menu. Nothing is written to the disk's boot sector or to
# the ESP's fallback path (EFI/BOOT), which belong to the other system.
MIB = 1024 * 1024
MIN_BESIDE_MIB = MIN_DISK_BYTES // MIB
DATA_PARTITION_MIB = 512
ESP_TYPE_GUID = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
# shim, GRUB and MokManager take about 4 MiB; the rest is headroom for updates.
MIN_ESP_FREE_BYTES = 16 * MIB
EFI_FIRMWARE_DIR = "/sys/firmware/efi"
BOOT_ENTRY_LABEL = "Lab Kiosk"
BOOT_ENTRY_LOADER = "\\EFI\\LabKiosk\\shimx64.efi"
BESIDE_PARTITION_NAMES = ("LABKIOSK_ROOT", "LABKIOSK_DATA", "LABKIOSK_SWAP")

def write_status(state, step, progress, error=None):
    data = {
        "state": state,       # "idle", "running", "completed", "error"
        "step": step,
        "progress": progress, # 0 to 100
        "error": error
    }
    try:
        with open(STATUS_FILE, "w") as f:
            json.dump(data, f)
    except Exception as e:
        print(f"Error writing status: {e}", file=sys.stderr)

def get_status():
    if not os.path.exists(STATUS_FILE):
        return {"state": "idle", "step": "Waiting for installation command", "progress": 0, "error": None}
    try:
        with open(STATUS_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {"state": "idle", "step": "Unknown", "progress": 0, "error": None}

def run_cmd(cmd, check=True):
    print(f"[INSTALL] Executing: {' '.join(cmd)}", file=sys.stderr)
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if check and proc.returncode != 0:
        raise RuntimeError(f"Command failed ({proc.returncode}): {' '.join(cmd)}\nStderr: {proc.stderr}")
    return proc.stdout.strip()

def kernel_args():
    try:
        with open("/proc/cmdline", "r") as handle:
            return handle.read().split()
    except OSError:
        return []


def is_installed_system():
    """
    Booted from an installed disk rather than from the ISO.

    Both now boot through live-boot, so /run/live and boot=live are present on
    either; only the installed boot menu adds labkiosk.installed=1. The old
    marker file still identifies a disk installed before the image store.
    """
    return INSTALLED_ARG in kernel_args() or os.path.exists("/etc/labkiosk-installed")


def is_live_session():
    """
    Check if currently running from live installer media (USB/ISO).
    Returns False when booted from an installed internal drive.
    """
    if is_installed_system():
        return False
    if os.path.exists("/run/live") or os.path.exists("/lib/live/mount"):
        return True
    return "boot=live" in kernel_args()

# Mount points live-boot uses for the medium the system booted from. Anything
# backed by one of these is the USB stick or optical disc running this very
# session.
LIVE_MEDIUM_MOUNTS = (
    "/run/live/medium",
    "/run/live/findiso",
    "/run/live/persistence",
    "/lib/live/mount/medium",
    "/lib/live/mount/findiso",
)


def parent_disk_of(device_path):
    """Map a partition node such as /dev/sdb1 to its whole disk, e.g. 'sdb'."""
    name = os.path.basename(device_path.strip())
    if not name:
        return ""
    sys_path = os.path.join("/sys/class/block", name)
    if not os.path.exists(sys_path):
        return ""
    resolved = os.path.realpath(sys_path)
    parent = os.path.basename(os.path.dirname(resolved))
    # A whole disk resolves directly under .../block, whose parent is not itself
    # a block device; a partition resolves inside its disk's directory.
    if parent and os.path.exists(os.path.join("/sys/class/block", parent)):
        return parent
    return name


def live_medium_disks():
    """
    Whole disks that the running live session is booted from.

    Without this the installer happily offered the USB stick it was running
    from as an install target, and selecting it repartitioned the medium out
    from under the running system. Detection is by mount point rather than by
    the removable flag, because a removable flag is neither necessary (an
    installed thin client can expose internal eMMC as removable) nor sufficient
    (some USB enclosures report non-removable).
    """
    disks = set()
    try:
        with open("/proc/mounts", "r") as handle:
            mounts = handle.read().splitlines()
    except OSError as err:
        print(f"[INSTALL] WARNING: cannot read /proc/mounts: {err}", file=sys.stderr)
        return disks

    for line in mounts:
        parts = line.split()
        if len(parts) < 2:
            continue
        source, mount_point = parts[0], parts[1]
        if not source.startswith("/dev/"):
            continue
        if not any(mount_point.startswith(m) for m in LIVE_MEDIUM_MOUNTS):
            continue

        if os.path.basename(source).startswith("loop"):
            # The ISO was loop-mounted from a file on another filesystem
            # (findiso). Follow the backing file to the disk that holds it.
            backing = os.path.join("/sys/class/block", os.path.basename(source),
                                   "loop", "backing_file")
            try:
                with open(backing, "r") as handle:
                    print(
                        f"[INSTALL] Live medium is a loop image at {handle.read().strip()}; "
                        "excluding every disk with a live mount.",
                        file=sys.stderr,
                    )
            except OSError:
                pass
            continue

        disk = parent_disk_of(source)
        if disk:
            disks.add(disk)

    if disks:
        print(f"[INSTALL] Live boot medium detected on: {sorted(disks)}", file=sys.stderr)
    return disks


def list_disks():
    """Detect candidate internal drives, excluding the live boot medium."""
    if NETBOOT_ARG in kernel_args():
        print("[INSTALL] Started over the network. Internal installation is disabled.", file=sys.stderr)
        return []
    if not is_live_session():
        print("[INSTALL] System is running from an installed disk. Internal installation is disabled.", file=sys.stderr)
        return []

    disks = []
    seen = set()
    excluded = live_medium_disks()

    # Method 1: lsblk JSON inspection
    try:
        out = run_cmd(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,ROTA,TYPE,RM,RO"], check=False)
        data = json.loads(out)
        blockdevices = data.get("blockdevices", [])
        for dev in blockdevices:
            if dev.get("type") != "disk":
                continue
            name = dev.get("name", "")
            if not name or name.startswith("loop") or name.startswith("sr") or name.startswith("zram") or name.startswith("ram"):
                continue
            if name in excluded:
                print(f"[INSTALL] Skipping {name}: it is the live boot medium.", file=sys.stderr)
                continue

            size_val = dev.get("size", 0)
            try:
                size_bytes = int(size_val) if size_val is not None else 0
            except (ValueError, TypeError):
                size_bytes = 0

            if size_bytes < MIN_DISK_BYTES:
                continue

            size_gb = round(size_bytes / (1024 * 1024 * 1024), 1)
            raw_model = dev.get("model") or "Internal Storage"
            model = str(raw_model).strip()
            path = dev.get("path") or f"/dev/{name}"

            disks.append({
                "name": name,
                "path": path,
                "size": f"{size_gb} GB",
                "model": model,
                "removable": bool(dev.get("rm", False)),
                "dualBoot": describe_dual_boot(path),
            })
            seen.add(name)
    except Exception as e:
        print(f"Error enumerating disks via lsblk: {e}", file=sys.stderr)

    # Method 2: Kernel /sys/block fallback
    if not disks and os.path.exists("/sys/block"):
        try:
            for b in os.listdir("/sys/block"):
                if b in seen or b.startswith("loop") or b.startswith("sr") or b.startswith("zram") or b.startswith("ram"):
                    continue
                if b in excluded:
                    print(f"[INSTALL] Skipping {b}: it is the live boot medium.", file=sys.stderr)
                    continue
                dev_dir = os.path.join("/sys/block", b)
                size_file = os.path.join(dev_dir, "size")
                if not os.path.isfile(size_file):
                    continue
                try:
                    sectors = int(open(size_file).read().strip())
                    size_bytes = sectors * 512
                    if size_bytes < MIN_DISK_BYTES:
                        continue
                    size_gb = round(size_bytes / (1024 * 1024 * 1024), 1)
                    model_file = os.path.join(dev_dir, "device", "model")
                    model = open(model_file).read().strip() if os.path.isfile(model_file) else "Internal Virtual/Physical Drive"
                    removable_file = os.path.join(dev_dir, "removable")
                    try:
                        with open(removable_file) as rf:
                            removable = rf.read().strip() == "1"
                    except OSError:
                        removable = False
                    disks.append({
                        "name": b,
                        "path": f"/dev/{b}",
                        "size": f"{size_gb} GB",
                        "model": model,
                        "removable": removable,
                        "dualBoot": describe_dual_boot(f"/dev/{b}"),
                    })
                except Exception:
                    pass
        except Exception as e:
            print(f"Error scanning /sys/block: {e}", file=sys.stderr)

    # Internal drives first. Removable ones are listed rather than hidden --
    # some thin clients expose internal eMMC as removable, and hiding those
    # would make the installer useless on that hardware -- but they must never
    # be the default selection in the wizard.
    disks.sort(key=lambda d: (bool(d.get("removable")), d.get("name", "")))
    return disks


def booted_with_uefi():
    return os.path.isdir(EFI_FIRMWARE_DIR)


def format_gb(size_bytes):
    return f"{round(size_bytes / (1024 * 1024 * 1024), 1)} GB"


def read_layout_unprivileged(disk_path):
    """
    A disk's partition table as the wizard's listing sees it, without root:
    types and labels from lsblk (udev's database), offsets from sysfs, which
    always counts in 512-byte units.
    """
    out = run_cmd(["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,TYPE,PTTYPE,PARTTYPE,FSTYPE,LABEL", disk_path])
    devices = json.loads(out).get("blockdevices") or []
    if len(devices) != 1:
        raise RuntimeError(f"lsblk described {len(devices)} devices for {disk_path}")
    disk = devices[0]
    size = int(disk.get("size") or 0)
    partitions = []
    for child in disk.get("children") or []:
        if child.get("type") != "part":
            continue
        name = child.get("name", "")
        with open(os.path.join("/sys/class/block", name, "start"), "r", encoding="ascii") as handle:
            start = int(handle.read().strip()) * 512
        partitions.append({
            "path": child.get("path") or f"/dev/{name}",
            "start": start,
            "size": int(child.get("size") or 0),
            "esp": (child.get("parttype") or "").lower() == ESP_TYPE_GUID,
            "fstype": child.get("fstype") or "",
            "label": child.get("label") or "",
        })
    # GPT keeps its header and table in the first and last 34 sectors; one MiB
    # at either end covers both on any sector size, and keeps partitions aligned.
    return {"label": disk.get("pttype") or "", "usable": (MIB, size - MIB), "partitions": partitions}


def read_partition_table(disk_path):
    """
    The same layout, as root, straight from the partition table: parted's
    machine-readable listing, in bytes. parted marks the EFI system partition
    with its `esp` flag, which is its GPT type.
    """
    no_table = RuntimeError(
        f"{disk_path} has no partition table that can be read, so there is no other system "
        "to install beside. Choose 'Erase the drive' instead."
    )
    try:
        out = run_cmd(["parted", "-s", "-m", disk_path, "unit", "B", "print"])
    except RuntimeError as err:
        raise no_table from err
    lines = [line.rstrip(";") for line in out.splitlines() if line.strip()]
    if len(lines) < 2 or lines[0] != "BYT":
        raise RuntimeError(f"parted printed an unexpected listing for {disk_path}: {out[:200]!r}")
    header = lines[1].split(":")
    if len(header) < 6 or header[5] in ("", "unknown"):
        raise no_table
    size = int(header[1].rstrip("B"))
    partitions = []
    for line in lines[2:]:
        fields = line.split(":")
        if len(fields) < 7 or not fields[0].isdigit():
            raise RuntimeError(f"parted printed an unexpected partition line for {disk_path}: {line!r}")
        flags = {flag.strip() for flag in fields[-1].split(",")}
        partitions.append({
            "path": partition_node(disk_path, int(fields[0])),
            "start": int(fields[1].rstrip("B")),
            "size": int(fields[3].rstrip("B")),
            "esp": "esp" in flags,
            "fstype": fields[4],
            "label": ":".join(fields[5:-1]),
        })
    return {"label": header[5], "usable": (MIB, size - MIB), "partitions": partitions}


def free_regions(layout, without=None):
    """
    Unallocated stretches of the disk as (start MiB, end MiB), end exclusive,
    rounded inwards to whole MiB. `without` names a partition to count as free:
    the stretch an install would get by replacing it.
    """
    first = -(-layout["usable"][0] // MIB)
    last = layout["usable"][1] // MIB
    regions = []
    cursor = first
    for part in sorted(layout["partitions"], key=lambda p: p["start"]):
        if part["path"] == without:
            continue
        part_first = part["start"] // MIB
        part_end = -(-(part["start"] + part["size"]) // MIB)
        if min(part_first, last) > cursor:
            regions.append((cursor, min(part_first, last)))
        cursor = max(cursor, part_end)
    if last > cursor:
        regions.append((cursor, last))
    return regions


def beside_region(layout, replace=None):
    """
    Where an install beside another system goes: the largest free stretch, or
    the stretch the partition `replace` leaves when it is removed. None when
    it is smaller than an installation needs.
    """
    if replace is None:
        regions = free_regions(layout)
    else:
        part_first = replace["start"] // MIB
        part_end = -(-(replace["start"] + replace["size"]) // MIB)
        regions = [r for r in free_regions(layout, without=replace["path"]) if r[0] < part_end and r[1] > part_first]
    best = max(regions, key=lambda r: r[1] - r[0], default=None)
    if best is None or best[1] - best[0] < MIN_BESIDE_MIB:
        return None
    return best


def find_esp(layout):
    return next((p for p in layout["partitions"] if p["esp"]), None)


def busy_partitions(paths):
    """
    The partitions among `paths` that something is using: mounted, active swap,
    or held by device-mapper (an open LUKS container, an active LVM volume).
    An install beside another system refuses to touch a disk with any of them
    rather than unmount another system's file systems out from under it.
    """
    by_real = {os.path.realpath(path): path for path in paths}
    busy = set()
    for proc_file, skip in (("/proc/mounts", 0), ("/proc/swaps", 1)):
        try:
            with open(proc_file, "r", encoding="utf-8") as handle:
                lines = handle.read().splitlines()[skip:]
        except OSError as err:
            raise RuntimeError(f"cannot read {proc_file}: {err}") from err
        for line in lines:
            fields = line.split()
            if fields and os.path.realpath(fields[0]) in by_real:
                busy.add(by_real[os.path.realpath(fields[0])])
    for path in paths:
        holders = os.path.join("/sys/class/block", os.path.basename(path), "holders")
        if os.path.isdir(holders) and os.listdir(holders):
            busy.add(path)
    return busy


def dual_boot_info(layout, uefi, busy=frozenset()):
    """Whether, and where, the wizard can offer to install beside the disk's other system."""
    info = {"possible": False, "reason": None, "freeBytes": 0, "free": format_gb(0), "partitions": []}
    if not uefi:
        info["reason"] = ("This computer started in legacy BIOS mode. Installing beside another system "
                          "needs UEFI: start the computer in UEFI mode, or erase the drive.")
        return info
    if layout["label"] == "dos":
        info["reason"] = ("The drive has an MBR partition table. Installing beside another system needs GPT; "
                          "erase the drive instead.")
        return info
    if layout["label"] != "gpt":
        info["reason"] = "The drive has no partition table, so there is no other system on it to keep."
        return info
    esp = find_esp(layout)
    if esp is None:
        info["reason"] = ("The drive has no EFI system partition, so its other system cannot be kept "
                          "in the firmware's boot menu. Erase the drive instead.")
        return info
    largest = max((end - start for start, end in free_regions(layout)), default=0)
    info["freeBytes"] = largest * MIB
    info["free"] = format_gb(largest * MIB)
    for part in layout["partitions"]:
        replaceable = part is not esp and part["path"] not in busy and beside_region(layout, part) is not None
        info["partitions"].append({
            "path": part["path"],
            "size": format_gb(part["size"]),
            "sizeBytes": part["size"],
            "fstype": part["fstype"],
            "label": part["label"],
            "replaceable": replaceable,
        })
    info["possible"] = largest >= MIN_BESIDE_MIB or any(p["replaceable"] for p in info["partitions"])
    if not info["possible"]:
        info["reason"] = (f"The drive has no free space of at least {MIN_BESIDE_MIB // 1024} GiB and no "
                          "partition that large to replace. Shrink a partition from the other system first.")
    return info


def describe_dual_boot(disk_path):
    try:
        layout = read_layout_unprivileged(disk_path)
        busy = busy_partitions([p["path"] for p in layout["partitions"]])
        return dual_boot_info(layout, booted_with_uefi(), busy)
    except (OSError, ValueError, RuntimeError) as err:
        print(f"[INSTALL] Cannot read the partitions of {disk_path}: {err}", file=sys.stderr)
        return {"possible": False, "reason": f"The drive's partitions could not be read: {err}",
                "freeBytes": 0, "free": format_gb(0), "partitions": []}


def partition_node(disk, number):
    return f"{disk}p{number}" if disk[-1].isdigit() else f"{disk}{number}"


def partition_number(node):
    with open(os.path.join("/sys/class/block", os.path.basename(node), "partition"), "r",
              encoding="ascii") as handle:
        return int(handle.read().strip())


def partition_numbers(disk):
    out = run_cmd(["parted", "-s", "-m", disk, "unit", "MiB", "print"])
    return {int(line.split(":", 1)[0]) for line in out.splitlines() if line.split(":", 1)[0].isdigit()}


def plan_beside_install(target_disk, replace_partition=None):
    """
    Check everything an install beside another system needs, before anything
    is written: UEFI, a GPT disk with an EFI system partition that has room,
    nothing on the disk in use, and a stretch of at least MIN_BESIDE_MIB.
    """
    if not booted_with_uefi():
        raise RuntimeError("This computer started in legacy BIOS mode; installing beside another system needs UEFI.")
    layout = read_partition_table(target_disk)
    if layout["label"] != "gpt":
        raise RuntimeError(f"{target_disk} has a {layout['label'] or 'unknown'} partition table; "
                           "installing beside another system needs GPT.")
    esp = find_esp(layout)
    if esp is None:
        raise RuntimeError(f"{target_disk} has no EFI system partition.")
    busy = busy_partitions([p["path"] for p in layout["partitions"]])
    if busy:
        raise RuntimeError(f"{', '.join(sorted(busy))} on {target_disk} is in use. Nothing on the drive may be "
                           "mounted while Lab Kiosk installs beside it; restart the installer and try again.")

    replace = None
    if replace_partition is not None:
        if not PARTITION_PATTERN.match(replace_partition):
            raise ValueError(f"Refusing to replace {replace_partition!r}: not a partition device node.")
        real = os.path.realpath(replace_partition)
        replace = next((p for p in layout["partitions"] if os.path.realpath(p["path"]) == real), None)
        if replace is None:
            raise ValueError(f"{replace_partition} is not a partition of {target_disk}.")
        if replace is esp:
            raise ValueError(f"{replace_partition} is the EFI system partition; every system on the drive boots from it.")
    region = beside_region(layout, replace)
    if region is None:
        where = f"replacing {replace_partition}" if replace else "in the drive's free space"
        raise RuntimeError(f"There is not enough room {where}: Lab Kiosk needs {MIN_BESIDE_MIB // 1024} GiB.")

    # The other system's ESP is only read here, to see that the boot loader fits.
    os.makedirs(TARGET_ESP_MOUNT, exist_ok=True)
    run_cmd(["mount", "-o", "ro", "-t", "vfat", esp["path"], TARGET_ESP_MOUNT])
    try:
        stats = os.statvfs(TARGET_ESP_MOUNT)
    finally:
        run_cmd(["umount", TARGET_ESP_MOUNT])
    free = stats.f_bavail * stats.f_frsize
    if free < MIN_ESP_FREE_BYTES:
        raise RuntimeError(f"The EFI system partition {esp['path']} has {free // MIB} MiB free; "
                           f"Lab Kiosk's boot loader needs {MIN_ESP_FREE_BYTES // MIB} MiB.")
    return {
        "esp": esp["path"],
        "esp_number": partition_number(esp["path"]),
        "region": region,
        "replace": replace and {"path": replace["path"], "number": partition_number(replace["path"])},
    }


def partition_beside(target_disk, plan):
    """
    Create the image store, data and swap partitions inside the planned
    stretch; returns the ESP, root, data and swap nodes. New partition numbers
    are read back from the table rather than assumed: they fill the lowest
    numbers the other system left free.
    """
    if plan["replace"]:
        write_status("running", f"Removing partition {plan['replace']['path']}...", 18)
        run_cmd(["wipefs", "-a", plan["replace"]["path"]])
        run_cmd(["parted", "-s", target_disk, "rm", str(plan["replace"]["number"])])

    start, end = plan["region"]
    swap_end = end - DATA_PARTITION_MIB
    swap_start = swap_end - SWAP_PARTITION_MIB
    root_name, data_name, swap_name = BESIDE_PARTITION_NAMES

    def make(name, fs_type, first, last):
        before = partition_numbers(target_disk)
        run_cmd(["parted", "-s", target_disk, "--", "mkpart", name, fs_type, f"{first}MiB", f"{last}MiB"])
        added = partition_numbers(target_disk) - before
        if len(added) != 1:
            raise RuntimeError(f"parted reported {len(added)} new partitions after creating {name}")
        return partition_node(target_disk, added.pop())

    write_status("running", "Creating Lab Kiosk's partitions beside the other system...", 20)
    part_root = make(root_name, "ext4", start, swap_start)
    part_data = make(data_name, "ext4", swap_end, end)
    part_swap = make(swap_name, "linux-swap", swap_start, swap_end)
    time.sleep(2)
    run_cmd(["partprobe", target_disk], check=False)
    for _ in range(10):
        if all(os.path.exists(node) for node in (part_root, part_data, part_swap)):
            break
        time.sleep(0.5)
    return plan["esp"], part_root, part_data, part_swap


def boot_entries(listing):
    """efibootmgr's output as (BootOrder, {number: label})."""
    order = []
    entries = {}
    for line in listing.splitlines():
        if line.startswith("BootOrder:"):
            order = [n.strip().upper() for n in line.split(":", 1)[1].split(",") if n.strip()]
            continue
        match = re.match(r"^Boot([0-9A-Fa-f]{4})\*?\s(.*)\Z", line)
        if match:
            entries[match.group(1).upper()] = re.split(r"\t|\s{2,}", match.group(2), maxsplit=1)[0].strip()
    return order, entries


def register_boot_entry(target_disk, esp_number):
    """
    Give Lab Kiosk its own firmware boot entry, first in the boot order, so the
    workstation starts into the kiosk unattended; the other system stays in the
    firmware's boot menu. Entries an earlier Lab Kiosk install left are removed
    first, so there is exactly one.
    """
    _, entries = boot_entries(run_cmd(["efibootmgr"]))
    for number, label in entries.items():
        if label == BOOT_ENTRY_LABEL:
            run_cmd(["efibootmgr", "--bootnum", number, "--delete-bootnum"])
    run_cmd(["efibootmgr", "--create", "--disk", target_disk, "--part", str(esp_number),
             "--label", BOOT_ENTRY_LABEL, "--loader", BOOT_ENTRY_LOADER])
    order, entries = boot_entries(run_cmd(["efibootmgr"]))
    ours = {number for number, label in entries.items() if label == BOOT_ENTRY_LABEL}
    if len(ours) != 1 or not order or order[0] not in ours:
        raise RuntimeError(
            "Lab Kiosk is on the drive, but the firmware did not keep its boot entry first in the boot order. "
            f"Choose '{BOOT_ENTRY_LOADER}' in the firmware's boot settings to start it."
        )
    print(f"[INSTALL] Firmware boot entry Boot{ours.pop()} '{BOOT_ENTRY_LABEL}' is first in the boot order.",
          file=sys.stderr)

def locate_running_image():
    """
    The system image this live session booted from, and its release version.

    The installer copies these exact files onto the disk: the installed system
    then boots the same squashfs, kernel and initrd as the ISO, through
    live-boot, instead of an rsync of the running root (docs/OTA_UPDATES.md
    section 5.1). Everything is checked here, before the disk is touched.
    """
    try:
        with open(IMAGE_VERSION_FILE, "r", encoding="utf-8") as handle:
            version = handle.read().strip()
    except OSError as err:
        raise RuntimeError(f"cannot read the image version from {IMAGE_VERSION_FILE}: {err}") from err
    if not IMAGE_VERSION_PATTERN.match(version):
        raise RuntimeError(f"{IMAGE_VERSION_FILE} holds {version!r}, which is not a release version")

    for directory in LIVE_IMAGE_DIRS:
        if all(os.path.isfile(os.path.join(directory, name)) for name in IMAGE_FILES):
            return directory, version
    raise RuntimeError(
        "the live medium's system image was not found (looked for "
        f"{', '.join(IMAGE_FILES)} in {', '.join(LIVE_IMAGE_DIRS)}). "
        "If this session was started with 'toram', restart from the normal menu "
        "entry to install."
    )


def copy_image_file(source, destination, report):
    """Copy one image file and flush it to disk; report(done_bytes) as it goes."""
    expected = os.path.getsize(source)
    done = 0
    with open(source, "rb") as src, open(destination, "wb") as dst:
        while True:
            chunk = src.read(IMAGE_COPY_CHUNK)
            if not chunk:
                break
            dst.write(chunk)
            done += len(chunk)
            report(done)
        dst.flush()
        os.fsync(dst.fileno())
    if done != expected:
        raise RuntimeError(f"copied {done} of {expected} bytes of {source}")
    os.chmod(destination, 0o644)


def install_to_disk(target_disk, grub_password_hash=None, hostname=None, dual_boot=False,
                    replace_partition=None):
    """
    Install onto target_disk: the whole drive, erased, or -- with dual_boot or
    replace_partition -- beside the system already on it.
    """
    beside = dual_boot or replace_partition is not None
    if os.geteuid() != 0:
        raise PermissionError("Installer must run as root")

    if hostname is not None and not HOSTNAME_PATTERN.match(hostname):
        raise ValueError(
            f"Refusing hostname {hostname!r}: use 1-63 lowercase letters, digits and hyphens, "
            "not starting or ending with a hyphen."
        )

    if NETBOOT_ARG in kernel_args():
        raise RuntimeError("This computer was started over the network; it is not installed to a drive.")
    if not is_live_session():
        raise RuntimeError("Lab Kiosk OS is already installed on this computer. Re-installation is disabled.")

    if not TARGET_DISK_PATTERN.match(target_disk):
        raise ValueError(
            f"Refusing to install to {target_disk!r}: not a whole-disk device node."
        )

    if not os.path.exists(target_disk):
        raise ValueError(f"Target disk does not exist: {target_disk}")

    # Re-checked here, immediately before wipefs, and not only when the list was
    # built: the caller may have been holding a stale list, and this is the last
    # point at which the running system can still be saved from itself.
    if os.path.basename(target_disk) in live_medium_disks():
        raise RuntimeError(
            f"Refusing to install to {target_disk}: this is the medium the live "
            "session is running from. Choose the computer's internal drive."
        )

    size_bytes = disk_size_bytes(target_disk)
    if size_bytes < MIN_DISK_BYTES:
        raise ValueError(
            f"Refusing to install to {target_disk}: {size_bytes // (1024 * 1024)} MiB is smaller than the "
            f"{MIN_DISK_BYTES // (1024 ** 3)} GiB minimum, which holds two system images."
        )
    plan = plan_beside_install(target_disk, replace_partition) if beside else None

    # Everything the new disk needs is found before anything is erased, so a
    # broken medium fails here and not halfway through with a wiped disk.
    image_dir, version = locate_running_image()
    for required in (GRUB_CFG_TEMPLATE, BOOT_SLOTS_HELPER):
        if not os.path.isfile(required):
            raise RuntimeError(f"{required} is missing from this image; it cannot install a bootable disk.")

    print(f"[INSTALL] Target disk selected: {target_disk}; system image {version} from {image_dir}",
          file=sys.stderr)
    write_status("running", f"Preparing target disk {target_disk}...", 10)

    if beside:
        print(f"[INSTALL] Installing beside the existing system in MiB {plan['region'][0]}-{plan['region'][1]}"
              f"{' replacing ' + plan['replace']['path'] if plan['replace'] else ''}; ESP {plan['esp']}.",
              file=sys.stderr)
        part_esp, part_root, part_data, part_swap = partition_beside(target_disk, plan)
    else:
        part_esp, part_root, part_data, part_swap = partition_whole_disk(target_disk)

    write_status("running", "Formatting file systems (FAT32 & ext4)...", 25)
    # The ESP is formatted only on an erased drive: beside another system it
    # already holds that system's boot loader.
    if not beside:
        run_cmd(["mkfs.vfat", "-F", "32", "-n", "ESP", part_esp])
    run_cmd(["mkfs.ext4", "-F", "-L", "LABKIOSK_ROOT", part_root])

    # With a TPM 2.0 chip the data partition is encrypted (labkiosk-data-unlock);
    # data_fs is the device that holds its ext4 either way.
    encrypt_data = tpm2_available()
    data_key = None
    data_fs = part_data

    root_dir = TARGET_ROOT_MOUNT
    esp_dir = TARGET_ESP_MOUNT
    data_dir = TARGET_DATA_MOUNT
    boot_dir = os.path.join(root_dir, "boot")
    grub_dir = os.path.join(boot_dir, "grub")

    def cleanup_mounts():
        run_cmd(["sync"], check=False)
        for mount_point in (data_dir, esp_dir, root_dir):
            run_cmd(["umount", "-R", mount_point], check=False)
            run_cmd(["umount", "-l", mount_point], check=False)
        if encrypt_data and os.path.exists(f"/dev/mapper/{DATA_MAPPER_NAME}"):
            run_cmd(["cryptsetup", "close", DATA_MAPPER_NAME], check=False)
        if data_key:
            os.remove(data_key)
        run_cmd(["sync"], check=False)

    try:
        if encrypt_data:
            data_key = write_data_key()
            data_fs = format_encrypted_data(part_data, data_key)
        else:
            print("[INSTALL] No TPM 2.0 chip: the data partition is not encrypted.", file=sys.stderr)
            run_cmd(["mkfs.ext4", "-F", "-L", "LABKIOSK_DATA", part_data])
        for device, mount_point in ((part_root, root_dir), (part_esp, esp_dir), (data_fs, data_dir)):
            os.makedirs(mount_point, exist_ok=True)
            run_cmd(["mount", device, mount_point])

        # Only root may change the image store; everyone may read it, which is
        # how the agent reads the boot-menu password digest to check the
        # administrator password.
        os.chmod(root_dir, 0o755)

        image_dest = os.path.join(root_dir, "images", version)
        os.makedirs(image_dest, mode=0o755)
        os.chmod(os.path.join(root_dir, "images"), 0o755)
        total = sum(os.path.getsize(os.path.join(image_dir, name)) for name in IMAGE_FILES)
        copied_before = 0
        for name in IMAGE_FILES:
            source = os.path.join(image_dir, name)

            def report(done, base=copied_before):
                percent = 30 + int(40 * (base + done) / max(total, 1))
                write_status("running", f"Copying the Lab Kiosk OS {version} system image to the drive...", percent)

            copy_image_file(source, os.path.join(image_dest, name), report)
            copied_before += os.path.getsize(source)
        print(f"[INSTALL] Copied system image {version} ({total} bytes) to {image_dest}.", file=sys.stderr)

        write_status("running", "Saving network and enrolment settings...", 72)
        seed_data_partition(data_dir)

        write_status("running", "Installing GRUB bootloader to internal storage...", 80)
        uefi_installed = False
        bios_installed = False
        bootloader_errors = []

        # The boot loader is installed from this live session, which carries the
        # same GRUB packages as every image; there is no root filesystem on the
        # disk to chroot into any more. --boot-directory puts grub.cfg and the
        # modules on the image store, outside every image.
        # --uefi-secure-boot: Microsoft-signed shim, then Debian-signed GRUB,
        # which boots only Debian-signed kernels -- so the disk starts with
        # Secure Boot on. Named rather than left to grub-install's default,
        # which depends on how this live session itself was started.
        try:
            run_cmd([
                "grub-install",
                "--target=x86_64-efi",
                f"--efi-directory={esp_dir}",
                f"--boot-directory={boot_dir}",
                "--uefi-secure-boot",
                "--bootloader-id=LabKiosk",
                "--no-nvram",
                "--recheck",
            ], check=True)
            # The fallback path EFI/BOOT belongs to the other system on a
            # shared drive; there, the firmware entry below starts Lab Kiosk.
            if not beside:
                run_cmd([
                    "grub-install",
                    "--target=x86_64-efi",
                    f"--efi-directory={esp_dir}",
                    f"--boot-directory={boot_dir}",
                    "--uefi-secure-boot",
                    "--removable",
                    "--recheck",
                ], check=True)
            uefi_installed = True
        except Exception as err:
            print(f"[INSTALL] WARNING: UEFI bootloader installation failed: {err}", file=sys.stderr)
            bootloader_errors.append(f"UEFI: {err}")

        # Install Legacy BIOS bootloader into MBR / bios_grub. Never beside
        # another system: the boot sector is that system's.
        if not beside and not ("nvme" in target_disk or "mmcblk" in target_disk):
            try:
                run_cmd([
                    "grub-install",
                    "--target=i386-pc",
                    f"--boot-directory={boot_dir}",
                    target_disk,
                    "--recheck",
                ], check=True)
                bios_installed = True
            except Exception as err:
                print(f"[INSTALL] WARNING: BIOS bootloader installation failed: {err}", file=sys.stderr)
                bootloader_errors.append(f"BIOS: {err}")

        # Verify at least one bootloader succeeded, or verify boot files exist on ESP
        has_efi_files = False
        efi_check_dir = os.path.join(esp_dir, "EFI")
        if os.path.isdir(efi_check_dir):
            for root, dirs, files in os.walk(efi_check_dir):
                for f in files:
                    if f.lower().endswith(".efi"):
                        has_efi_files = True
                        break
                if has_efi_files:
                    break

        if not (uefi_installed or bios_installed or has_efi_files):
            raise RuntimeError(
                "Bootloader installation failed (both UEFI and BIOS failed, and no EFI binaries found on ESP). "
                f"Details: {'; '.join(bootloader_errors)}"
            )
        if beside:
            # The other system's files on the ESP prove nothing here: Lab
            # Kiosk's own loader must be there.
            if not uefi_installed or not os.path.isfile(os.path.join(esp_dir, "EFI", "LabKiosk", "shimx64.efi")):
                raise RuntimeError(f"Lab Kiosk's boot loader was not installed: {'; '.join(bootloader_errors)}")
            write_status("running", "Adding Lab Kiosk to the computer's boot menu...", 85)
            register_boot_entry(target_disk, plan["esp_number"])

        write_status("running", "Configuring the boot menu...", 90)
        # One menu for every image: it reads which one to boot from grubenv, so
        # an update never has to regenerate it.
        os.makedirs(grub_dir, exist_ok=True)
        shutil.copyfile(GRUB_CFG_TEMPLATE, os.path.join(grub_dir, "grub.cfg"))
        os.chmod(os.path.join(grub_dir, "grub.cfg"), 0o644)
        write_grub_password(grub_dir, grub_password_hash)
        write_data_partition_id(grub_dir, data_fs)
        if encrypt_data:
            write_data_crypt_id(grub_dir, part_data)
            first_boot_key = os.path.join(grub_dir, FIRST_BOOT_KEY_FILE_NAME)
            shutil.copyfile(data_key, first_boot_key)
            os.chmod(first_boot_key, 0o600)
        write_swap_partition_id(grub_dir, part_swap)
        write_hostname(grub_dir, hostname or generate_hostname())

        proc = subprocess.run(
            [BOOT_SLOTS_HELPER, "init", version, "--boot-dir", grub_dir],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        for line in proc.stderr.strip().splitlines():
            print(f"[INSTALL] {line}", file=sys.stderr)
        if proc.returncode != 0:
            raise RuntimeError(f"could not write the boot environment: {proc.stdout.strip() or proc.returncode}")

        write_status("running", "Finalizing and synchronizing storage...", 95)
    finally:
        cleanup_mounts()

    write_status("completed", "Lab Kiosk OS successfully installed to internal drive!", 100)
    print("[INSTALL] SUCCESS! Installation complete.", file=sys.stderr)


def partition_whole_disk(target_disk):
    """Erase target_disk and lay it out; returns the ESP, root, data and swap nodes."""
    write_status("running", "Unmounting target partitions...", 15)
    run_cmd(["swapoff", "-a"], check=False)
    for mount_point in (TARGET_ROOT_MOUNT, TARGET_ESP_MOUNT, TARGET_DATA_MOUNT):
        run_cmd(["umount", "-R", mount_point], check=False)
    for part in range(1, 16):
        p_name = f"{target_disk}p{part}" if ("nvme" in target_disk or "mmcblk" in target_disk) else f"{target_disk}{part}"
        if os.path.exists(p_name):
            run_cmd(["umount", "-f", p_name], check=False)

    write_status("running", "Creating GPT partition table (BIOS & UEFI compatible)...", 20)
    run_cmd(["wipefs", "-a", "-f", target_disk], check=False)
    run_cmd(["parted", "-s", target_disk, "mklabel", "gpt"])
    # Partition 1: BIOS boot partition for legacy GRUB embedding (1MiB - 2MiB)
    run_cmd(["parted", "-s", target_disk, "mkpart", "bios_grub", "1MiB", "2MiB"])
    run_cmd(["parted", "-s", target_disk, "set", "1", "bios_grub", "on"])
    # Partition 2: EFI System Partition (2MiB - 514MiB)
    run_cmd(["parted", "-s", target_disk, "mkpart", "ESP", "fat32", "2MiB", "514MiB"])
    run_cmd(["parted", "-s", target_disk, "set", "2", "esp", "on"])
    # Partition 3: the image store (514MiB up to the swap partition). It holds the
    # boot menu and whole system images as files, never a root filesystem:
    #   boot/grub/                grub.cfg, grubenv, the boot-menu password
    #   images/<version>/         filesystem.squashfs, vmlinuz, initrd.img
    # The "--" is required, not stylistic: the end offset is negative (measured
    # back from the end of the disk) and parted's option parser otherwise reads
    # "-1537MiB" as a bundle of single-letter flags and aborts.
    swap_end = -512
    swap_start = swap_end - SWAP_PARTITION_MIB
    run_cmd(["parted", "-s", target_disk, "--", "mkpart", "ROOT", "ext4", "514MiB", f"{swap_start - 1}MiB"])
    # Partition 4: the only writable-across-reboots area on the machine.
    #
    # The installed system runs from its squashfs under a RAM overlay, so every
    # write to / is gone at power-off. That is the whole point for user state,
    # but it would also discard the device token: a workstation enrolled *after*
    # installation would come back unenrolled on the next boot, with nothing in
    # the UI to say so. /etc/labkiosk is mounted from here instead (by
    # etc-labkiosk.mount in the image), so the enrolment survives while the rest
    # of the OS stays immutable. 512 MiB is far more than the config needs and
    # keeps the partition comfortably alignable.
    run_cmd(["parted", "-s", target_disk, "--", "mkpart", "DATA", "ext4", f"{swap_end}MiB", "100%"])
    # Partition 5, between the image store and the data partition: swap, used
    # only when compressed RAM is full, and encrypted at every boot with a key
    # that never leaves RAM (labkiosk-swap). Created last so the data partition
    # keeps number 4. parted gives it the GPT Linux swap type, which
    # labkiosk-swap checks before it touches it; nothing is formatted here.
    run_cmd(["parted", "-s", target_disk, "--", "mkpart", "SWAP", "linux-swap", f"{swap_start}MiB", f"{swap_end}MiB"])
    time.sleep(2)
    run_cmd(["partprobe", target_disk], check=False)
    time.sleep(1)

    # Partition 1 is the bios_grub area: it holds no filesystem and is never
    # mounted, so only the ESP, ROOT and DATA node names are needed here.
    is_p_style = "nvme" in target_disk or "mmcblk" in target_disk or target_disk[-1].isdigit()
    part_esp  = f"{target_disk}p2" if is_p_style else f"{target_disk}2"
    part_root = f"{target_disk}p3" if is_p_style else f"{target_disk}3"
    part_data = f"{target_disk}p4" if is_p_style else f"{target_disk}4"
    part_swap = f"{target_disk}p5" if is_p_style else f"{target_disk}5"

    for _ in range(10):
        if os.path.exists(part_root) and os.path.exists(part_esp) and os.path.exists(part_data) \
                and os.path.exists(part_swap):
            break
        time.sleep(0.5)

    return part_esp, part_root, part_data, part_swap


def disk_size_bytes(target_disk):
    size_file = os.path.join("/sys/class/block", os.path.basename(target_disk), "size")
    try:
        with open(size_file, "r") as handle:
            return int(handle.read().strip()) * 512
    except (OSError, ValueError) as err:
        raise RuntimeError(f"cannot read the size of {target_disk}: {err}") from err


def copy_regular_file(source, destination):
    """
    Copy source if it is a regular file, never through a symlink.

    This runs as root (kiosk may start the installer through sudo) over
    /etc/labkiosk, which kiosk owns: a link planted there, say to /etc/shadow,
    must not be read as root and handed back to kiosk on the data partition.
    O_NOFOLLOW and fstat on the open file leave no window to swap one in.
    Returns False for anything that is not a regular file.
    """
    try:
        fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as err:
        if err.errno == errno.ELOOP:
            print(f"[INSTALL] Skipped {source}: a symbolic link, not a file.", file=sys.stderr)
            return False
        raise
    # fstat before fdopen: fdopen refuses a directory (system-connections sits
    # beside the files) with "Is a directory", and that must be a skip.
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        raise
    if not stat.S_ISREG(info.st_mode):
        os.close(fd)
        return False
    with os.fdopen(fd, "rb") as src:
        with open(destination, "wb") as dst:
            shutil.copyfileobj(src, dst)
        # Permission bits only: a kiosk-owned file must not hand setuid/setgid/sticky to root.
        os.chmod(destination, stat.S_IMODE(info.st_mode) & 0o777)
        os.utime(destination, ns=(info.st_atime_ns, info.st_mtime_ns))
    return True


def seed_data_partition(data_dir):
    """
    Carry the live session's enrolment and network profiles onto LABKIOSK_DATA.

    Without this, installing a workstation that was enrolled from the live
    session would produce a machine that boots up unenrolled.
    """
    source_config_dir = "/etc/labkiosk"
    data_conn_dir = os.path.join(data_dir, "system-connections")
    os.makedirs(data_conn_dir, exist_ok=True)
    os.chmod(data_conn_dir, 0o700)
    os.chown(data_conn_dir, 0, 0)

    # Carry the NetworkManager profiles configured in the live session (Wi-Fi
    # keys included) onto the data partition, which the installed system
    # bind-mounts over /etc/NetworkManager/system-connections: under the RAM
    # overlay that is the only place a profile survives a reboot.
    nm_dirs = ["/etc/NetworkManager/system-connections", os.path.join(source_config_dir, "system-connections")]
    for nm_dir in nm_dirs:
        if os.path.isdir(nm_dir):
            for entry in os.listdir(nm_dir):
                src_conn = os.path.join(nm_dir, entry)
                dst_conn = os.path.join(data_conn_dir, entry)
                if copy_regular_file(src_conn, dst_conn):
                    os.chmod(dst_conn, 0o600)
                    os.chown(dst_conn, 0, 0)
                    print(f"[INSTALL] Carried NetworkManager connection {entry} onto data partition.",
                          file=sys.stderr)

    # The proxy is deliberately not written into /etc/environment: proxy.json
    # is carried onto this partition here, and the agent applies it to itself
    # and to Chromium's policy at every start. Language, region, timezone and
    # keyboard travel the same way, in localization.json: the agent re-applies
    # them at every start (apply_saved_localization()), so nothing is written
    # into a system image, which an update replaces.
    if os.path.isdir(source_config_dir):
        stat_info = os.stat(source_config_dir)
        for entry in os.listdir(source_config_dir):
            src = os.path.join(source_config_dir, entry)
            dest = os.path.join(data_dir, entry)
            if not copy_regular_file(src, dest):
                continue
            # The copy carries the mode (0600) but not the owner, and this runs as
            # root -- so without this chown the agent, which runs as the kiosk
            # user, could not read back the very config it just enrolled with.
            os.chown(dest, stat_info.st_uid, stat_info.st_gid)
            print(f"[INSTALL] Carried enrolment file {entry} onto the data partition.",
                  file=sys.stderr)
        os.chown(data_dir, stat_info.st_uid, stat_info.st_gid)
    os.chmod(data_dir, 0o700)

    # Prove the kiosk user can actually write here, rather than letting the
    # workstation discover it at enrolment with a bare "Permission denied"
    # on a machine that has no shell to investigate it from.
    probe = os.path.join(data_dir, ".labkiosk-write-probe")
    probe_result = subprocess.run(
        ["runuser", "-u", "kiosk", "--", "touch", probe],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    if probe_result.returncode != 0:
        owner = os.stat(data_dir)
        raise RuntimeError(
            f"the data partition is not writable by the kiosk user "
            f"(owned by {owner.st_uid}:{owner.st_gid}, mode {owner.st_mode & 0o777:04o}): "
            f"{probe_result.stderr.strip()}"
        )
    os.unlink(probe)
    print("[INSTALL] Verified the kiosk user can write to the data partition.", file=sys.stderr)


def write_grub_password(grub_dir, grub_password_hash):
    """
    Boot-menu password for THIS installation.

    Deliberately applied here rather than baked into the ISO. A hash compiled
    into the image would be one password shared by every customer who ever
    received that ISO: a leak anywhere would compromise all of them, and it
    could not be rotated on machines already deployed. Applying it per
    installation keeps the image free of secrets and gives each site its own.

    It lives in boot/grub on the image store, outside every system image, so an
    update keeps it. grub.cfg sources it; the agent reads the same digest to
    check the administrator password (GRUB_PASSWORD_FILE in agent.py).

    Booting stays unattended either way: every entry in grub.cfg is
    --unrestricted, so `set superusers` gates only the edit (`e`) and
    command-line (`c`) keys.
    """
    password_file = os.path.join(grub_dir, GRUB_PASSWORD_FILE_NAME)
    if grub_password_hash:
        with open(password_file, "w") as handle:
            handle.write('set superusers="labkiosk"\n')
            handle.write(f"password_pbkdf2 labkiosk {grub_password_hash}\n")
        os.chmod(password_file, 0o644)
        print("[INSTALL] Boot-menu password applied to the installed system.", file=sys.stderr)
    else:
        print(
            "[INSTALL] WARNING: no boot-menu password supplied. A user at the keyboard "
            "can edit the GRUB entry and boot with init=/bin/sh.",
            file=sys.stderr,
        )


def write_data_partition_id(grub_dir, part_data):
    """
    Pin /etc/labkiosk to THIS disk's data partition.

    grub.cfg sources the file and passes labkiosk.data=<uuid> to the kernel;
    labkiosk-data-generator mounts exactly that UUID. Mounting by label would
    let any USB stick formatted as LABKIOSK_DATA supply the agent's enrolment,
    proxy and Wi-Fi profiles. Like the boot password it lives in boot/grub,
    outside every system image, so an update keeps it.
    """
    data_uuid = run_cmd(["blkid", "-s", "UUID", "-o", "value", part_data])
    if not FS_UUID_PATTERN.match(data_uuid):
        raise RuntimeError(f"blkid returned no usable UUID for the data partition ({part_data}): {data_uuid!r}")
    id_file = os.path.join(grub_dir, DATA_ID_FILE_NAME)
    with open(id_file, "w") as handle:
        handle.write(f'set data_uuid="{data_uuid}"\n')
    os.chmod(id_file, 0o644)
    print(f"[INSTALL] Data partition pinned by UUID {data_uuid}.", file=sys.stderr)


def tpm2_available(class_dir=TPM_CLASS_DIR, device=TPM_DEVICE):
    """
    A TPM 2.0 chip the kernel can talk to. The installer runs on the machine it
    installs, so this is the chip the installed system will unlock with.
    Kept identical to tpm2_present() in /usr/local/sbin/labkiosk-data-unlock.
    """
    if not os.path.exists(device):
        return False
    try:
        names = os.listdir(class_dir)
    except FileNotFoundError:
        return False
    for name in names:
        try:
            with open(os.path.join(class_dir, name, "tpm_version_major"), encoding="ascii") as handle:
                if handle.read().strip() == "2":
                    return True
        except OSError:
            continue
    return False


def write_data_key(key_dir="/run"):
    """A random key for the data partition, in RAM, readable by root only."""
    key_path = os.path.join(key_dir, f".labkiosk-data-install.{secrets.token_hex(8)}.key")
    fd = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="ascii") as handle:
        handle.write(secrets.token_hex(32))
    return key_path


def format_encrypted_data(part_data, key_path):
    """
    Make the data partition a LUKS2 container opened by key_path, with ext4
    inside; returns the opened device. The key is random, so a fast PBKDF
    costs nothing; the first installed boot seals a new key slot to the TPM
    and destroys this one (labkiosk-data-unlock).
    """
    run_cmd(["cryptsetup", "luksFormat", "--batch-mode", "--type", "luks2", "--pbkdf", "pbkdf2",
             "--pbkdf-force-iterations", "1000", f"--key-file={key_path}", part_data])
    run_cmd(["cryptsetup", "open", f"--key-file={key_path}", part_data, DATA_MAPPER_NAME])
    mapper = f"/dev/mapper/{DATA_MAPPER_NAME}"
    run_cmd(["mkfs.ext4", "-F", "-L", "LABKIOSK_DATA", mapper])
    print("[INSTALL] Data partition encrypted; the first boot seals its key to the TPM.", file=sys.stderr)
    return mapper


def write_data_crypt_id(grub_dir, part_data):
    """
    Name the data partition's LUKS container for grub.cfg, which passes
    labkiosk.datacrypt=<uuid>; labkiosk-data-unlock opens exactly that one.
    """
    crypt_uuid = run_cmd(["blkid", "-s", "UUID", "-o", "value", part_data])
    if not FS_UUID_PATTERN.match(crypt_uuid):
        raise RuntimeError(f"blkid returned no usable UUID for the encrypted data partition ({part_data}): {crypt_uuid!r}")
    id_file = os.path.join(grub_dir, DATA_CRYPT_FILE_NAME)
    with open(id_file, "w") as handle:
        handle.write(f'set data_luks_uuid="{crypt_uuid}"\n')
    os.chmod(id_file, 0o644)
    print(f"[INSTALL] Encrypted data partition pinned by UUID {crypt_uuid}.", file=sys.stderr)


def write_swap_partition_id(grub_dir, part_swap):
    """
    Name THIS disk's swap partition for labkiosk-swap, which opens it with a
    random key at every boot and so destroys whatever it holds: only the
    partition with exactly this GPT PARTUUID is ever used. grub.cfg sources the
    file and passes labkiosk.swap=<id>; it lives in boot/grub, so an update
    keeps it.
    """
    swap_id = run_cmd(["blkid", "-s", "PARTUUID", "-o", "value", part_swap])
    if not FS_UUID_PATTERN.match(swap_id):
        raise RuntimeError(f"blkid returned no usable PARTUUID for the swap partition ({part_swap}): {swap_id!r}")
    id_file = os.path.join(grub_dir, SWAP_ID_FILE_NAME)
    with open(id_file, "w") as handle:
        handle.write(f'set swap_partuuid="{swap_id}"\n')
    os.chmod(id_file, 0o644)
    print(f"[INSTALL] Swap partition pinned by PARTUUID {swap_id}.", file=sys.stderr)


def generate_hostname():
    """A name for a workstation nobody named: labkiosk- and six random hex digits."""
    return f"{HOSTNAME_PREFIX}{secrets.token_hex(3)}"


def write_hostname(grub_dir, hostname):
    """
    Store the workstation's hostname for grub.cfg, which passes it as
    labkiosk.hostname=<name>; labkiosk-hostname sets it at every boot. It lives
    in boot/grub, outside every system image, so an update keeps it.
    """
    if not HOSTNAME_PATTERN.match(hostname):
        raise RuntimeError(f"Not a valid hostname: {hostname!r}")
    name_file = os.path.join(grub_dir, HOSTNAME_FILE_NAME)
    with open(name_file, "w") as handle:
        handle.write(f'set kiosk_hostname="{hostname}"\n')
    os.chmod(name_file, 0o644)
    print(f"[INSTALL] Hostname {hostname}.", file=sys.stderr)


if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(
        description="Lab Kiosk OS - Automated Local Disk Installer",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--list-disks", action="store_true", help="List candidate storage drives")
    group.add_argument("--status", action="store_true", help="Get current installation status")
    group.add_argument("--target", help="Target disk to install to (e.g., /dev/sda)")
    parser.add_argument(
        "--grub-password-hash",
        help="GRUB PBKDF2 password hash (grub.pbkdf2.sha512...)",
    )
    parser.add_argument(
        "--hostname",
        help="The workstation's hostname (one lowercase DNS label); generated when omitted",
    )
    parser.add_argument(
        "--dual-boot",
        action="store_true",
        help="Install beside the system already on the disk, into its largest free space (UEFI and GPT only)",
    )
    parser.add_argument(
        "--replace-partition",
        help="Install beside the disk's other system in place of this partition (e.g. /dev/sda3); implies --dual-boot",
    )

    args = parser.parse_args()

    if args.grub_password_hash and not args.target:
        parser.error("--grub-password-hash requires --target")
    if args.hostname is not None and not args.target:
        parser.error("--hostname requires --target")
    if (args.dual_boot or args.replace_partition is not None) and not args.target:
        parser.error("--dual-boot and --replace-partition require --target")
    if args.replace_partition is not None and not PARTITION_PATTERN.match(args.replace_partition):
        parser.error("--replace-partition must name one partition, such as /dev/sda3 or /dev/nvme0n1p3")

    if args.list_disks:
        print(json.dumps(list_disks()))
        sys.exit(0)
    elif args.status:
        print(json.dumps(get_status()))
        sys.exit(0)
    elif args.target:
        grub_hash = args.grub_password_hash
        if grub_hash and not GRUB_PBKDF2_PATTERN.match(grub_hash):
            print(
                "[INSTALL] ERROR: --grub-password-hash is not a grub-mkpasswd-pbkdf2 "
                "digest (expected 'grub.pbkdf2.sha512.<rounds>.<salt>.<hash>').",
                file=sys.stderr,
            )
            sys.exit(1)
        try:
            install_to_disk(args.target, grub_hash, args.hostname, args.dual_boot, args.replace_partition)
            sys.exit(0)
        except Exception as err:
            print(f"[INSTALL] ERROR: {err}", file=sys.stderr)
            write_status("error", "Installation failed", 0, str(err))
            sys.exit(1)

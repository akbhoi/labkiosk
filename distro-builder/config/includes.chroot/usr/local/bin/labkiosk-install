#!/usr/bin/env python3
"""
Lab Kiosk OS - Automated Local Disk Installer
Installs the running Lab Kiosk OS to an internal hard drive, SSD, or NVMe disk.
"""

import sys
import os
import errno
import json
import subprocess
import time
import shutil
import re
import stat

STATUS_FILE = "/tmp/labkiosk-install-status.json"

# Whole-disk device nodes this installer will write to. The agent applies the
# same check before calling out (TARGET_DISK_PATTERN in
# /opt/labkiosk/agent/agent.py), but the agent is not the only caller:
# /etc/sudoers.d/50-labkiosk-install lets the kiosk user run this binary
# directly with NOPASSWD, so the argument is re-validated here rather than
# trusted. Keep the two patterns identical.
TARGET_DISK_PATTERN = re.compile(r"^/dev/(sd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)\Z")

# A grub-mkpasswd-pbkdf2 digest: grub.pbkdf2.sha512.<rounds>.<salt hex>.<hash hex>.
# Only the digest ever reaches this program -- the setup wizard derives it in the
# browser with WebCrypto, so the plaintext boot-menu password is never sent over
# the agent's API, never reaches a process argument, and is never written to disk.
GRUB_PBKDF2_PATTERN = re.compile(r"^grub\.pbkdf2\.sha512\.[0-9]+\.[0-9A-Fa-f]+\.[0-9A-Fa-f]+\Z")

# The installed disk is an image store (docs/OTA_UPDATES.md section 5.1): the
# live medium's squashfs, kernel and initrd are copied to images/<version>/ on
# LABKIOSK_ROOT and booted through live-boot, exactly as the ISO boots them.
LIVE_IMAGE_DIRS = ("/run/live/medium/live", "/lib/live/mount/medium/live")
IMAGE_FILES = ("vmlinuz", "initrd.img", "filesystem.squashfs")
IMAGE_COPY_CHUNK = 8 * 1024 * 1024
IMAGE_VERSION_FILE = "/usr/share/labkiosk/version"
# Kept identical to VERSION_PATTERN in /usr/local/sbin/labkiosk-boot-slots.
IMAGE_VERSION_PATTERN = re.compile(r"^[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}(?:-[0-9A-Za-z.]{1,32})?\Z")
GRUB_CFG_TEMPLATE = "/usr/share/labkiosk/boot/grub.cfg"
GRUB_PASSWORD_FILE_NAME = "labkiosk-password.cfg"
# The data partition's UUID, for grub.cfg to pass as labkiosk.data=<uuid>.
DATA_ID_FILE_NAME = "labkiosk-data.cfg"
# What mkfs.ext4 writes; grub.cfg and labkiosk-data-generator accept only this.
FS_UUID_PATTERN = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\Z")
BOOT_SLOTS_HELPER = "/usr/local/sbin/labkiosk-boot-slots"
TARGET_ROOT_MOUNT = "/mnt/target_kiosk"
TARGET_ESP_MOUNT = "/mnt/target_kiosk_esp"
TARGET_DATA_MOUNT = "/mnt/target_kiosk_data"
# Two system images side by side -- the running one and an update or the one
# kept for rollback -- at about 720 MiB each today, with room for them to grow
# (docs/OTA_UPDATES.md section 12 asks for 8 GB). Counted in GiB so that a
# drive sold as "8 GB" (8 000 000 000 bytes, or an eMMC a little under that)
# still qualifies.
MIN_DISK_BYTES = 7 * 1024 * 1024 * 1024
# On the kernel command line of every installed system (the boot menu adds it).
INSTALLED_ARG = "labkiosk.installed=1"

def write_status(state, step, progress, error=None):
    data = {
        "state": state,       # "idle", "running", "completed", "error"
        "step": step,
        "progress": progress, # 0 to 100
        "error": error
    }
    try:
        with open(STATUS_FILE, "w") as f:
            json.dump(data, f)
    except Exception as e:
        print(f"Error writing status: {e}", file=sys.stderr)

def get_status():
    if not os.path.exists(STATUS_FILE):
        return {"state": "idle", "step": "Waiting for installation command", "progress": 0, "error": None}
    try:
        with open(STATUS_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {"state": "idle", "step": "Unknown", "progress": 0, "error": None}

def run_cmd(cmd, check=True):
    print(f"[INSTALL] Executing: {' '.join(cmd)}", file=sys.stderr)
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if check and proc.returncode != 0:
        raise RuntimeError(f"Command failed ({proc.returncode}): {' '.join(cmd)}\nStderr: {proc.stderr}")
    return proc.stdout.strip()

def kernel_args():
    try:
        with open("/proc/cmdline", "r") as handle:
            return handle.read().split()
    except OSError:
        return []


def is_installed_system():
    """
    Booted from an installed disk rather than from the ISO.

    Both now boot through live-boot, so /run/live and boot=live are present on
    either; only the installed boot menu adds labkiosk.installed=1. The old
    marker file still identifies a disk installed before the image store.
    """
    return INSTALLED_ARG in kernel_args() or os.path.exists("/etc/labkiosk-installed")


def is_live_session():
    """
    Check if currently running from live installer media (USB/ISO).
    Returns False when booted from an installed internal drive.
    """
    if is_installed_system():
        return False
    if os.path.exists("/run/live") or os.path.exists("/lib/live/mount"):
        return True
    return "boot=live" in kernel_args()

# Mount points live-boot uses for the medium the system booted from. Anything
# backed by one of these is the USB stick or optical disc running this very
# session.
LIVE_MEDIUM_MOUNTS = (
    "/run/live/medium",
    "/run/live/findiso",
    "/run/live/persistence",
    "/lib/live/mount/medium",
    "/lib/live/mount/findiso",
)


def parent_disk_of(device_path):
    """Map a partition node such as /dev/sdb1 to its whole disk, e.g. 'sdb'."""
    name = os.path.basename(device_path.strip())
    if not name:
        return ""
    sys_path = os.path.join("/sys/class/block", name)
    if not os.path.exists(sys_path):
        return ""
    resolved = os.path.realpath(sys_path)
    parent = os.path.basename(os.path.dirname(resolved))
    # A whole disk resolves directly under .../block, whose parent is not itself
    # a block device; a partition resolves inside its disk's directory.
    if parent and os.path.exists(os.path.join("/sys/class/block", parent)):
        return parent
    return name


def live_medium_disks():
    """
    Whole disks that the running live session is booted from.

    Without this the installer happily offered the USB stick it was running
    from as an install target, and selecting it repartitioned the medium out
    from under the running system. Detection is by mount point rather than by
    the removable flag, because a removable flag is neither necessary (an
    installed thin client can expose internal eMMC as removable) nor sufficient
    (some USB enclosures report non-removable).
    """
    disks = set()
    try:
        with open("/proc/mounts", "r") as handle:
            mounts = handle.read().splitlines()
    except OSError as err:
        print(f"[INSTALL] WARNING: cannot read /proc/mounts: {err}", file=sys.stderr)
        return disks

    for line in mounts:
        parts = line.split()
        if len(parts) < 2:
            continue
        source, mount_point = parts[0], parts[1]
        if not source.startswith("/dev/"):
            continue
        if not any(mount_point.startswith(m) for m in LIVE_MEDIUM_MOUNTS):
            continue

        if os.path.basename(source).startswith("loop"):
            # The ISO was loop-mounted from a file on another filesystem
            # (findiso). Follow the backing file to the disk that holds it.
            backing = os.path.join("/sys/class/block", os.path.basename(source),
                                   "loop", "backing_file")
            try:
                with open(backing, "r") as handle:
                    print(
                        f"[INSTALL] Live medium is a loop image at {handle.read().strip()}; "
                        "excluding every disk with a live mount.",
                        file=sys.stderr,
                    )
            except OSError:
                pass
            continue

        disk = parent_disk_of(source)
        if disk:
            disks.add(disk)

    if disks:
        print(f"[INSTALL] Live boot medium detected on: {sorted(disks)}", file=sys.stderr)
    return disks


def list_disks():
    """Detect candidate internal drives, excluding the live boot medium."""
    if not is_live_session():
        print("[INSTALL] System is running from an installed disk. Internal installation is disabled.", file=sys.stderr)
        return []

    disks = []
    seen = set()
    excluded = live_medium_disks()

    # Method 1: lsblk JSON inspection
    try:
        out = run_cmd(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,ROTA,TYPE,RM,RO"], check=False)
        data = json.loads(out)
        blockdevices = data.get("blockdevices", [])
        for dev in blockdevices:
            if dev.get("type") != "disk":
                continue
            name = dev.get("name", "")
            if not name or name.startswith("loop") or name.startswith("sr") or name.startswith("zram") or name.startswith("ram"):
                continue
            if name in excluded:
                print(f"[INSTALL] Skipping {name}: it is the live boot medium.", file=sys.stderr)
                continue

            size_val = dev.get("size", 0)
            try:
                size_bytes = int(size_val) if size_val is not None else 0
            except (ValueError, TypeError):
                size_bytes = 0

            if size_bytes < MIN_DISK_BYTES:
                continue

            size_gb = round(size_bytes / (1024 * 1024 * 1024), 1)
            raw_model = dev.get("model") or "Internal Storage"
            model = str(raw_model).strip()
            path = dev.get("path") or f"/dev/{name}"

            disks.append({
                "name": name,
                "path": path,
                "size": f"{size_gb} GB",
                "model": model,
                "removable": bool(dev.get("rm", False))
            })
            seen.add(name)
    except Exception as e:
        print(f"Error enumerating disks via lsblk: {e}", file=sys.stderr)

    # Method 2: Kernel /sys/block fallback
    if not disks and os.path.exists("/sys/block"):
        try:
            for b in os.listdir("/sys/block"):
                if b in seen or b.startswith("loop") or b.startswith("sr") or b.startswith("zram") or b.startswith("ram"):
                    continue
                if b in excluded:
                    print(f"[INSTALL] Skipping {b}: it is the live boot medium.", file=sys.stderr)
                    continue
                dev_dir = os.path.join("/sys/block", b)
                size_file = os.path.join(dev_dir, "size")
                if not os.path.isfile(size_file):
                    continue
                try:
                    sectors = int(open(size_file).read().strip())
                    size_bytes = sectors * 512
                    if size_bytes < MIN_DISK_BYTES:
                        continue
                    size_gb = round(size_bytes / (1024 * 1024 * 1024), 1)
                    model_file = os.path.join(dev_dir, "device", "model")
                    model = open(model_file).read().strip() if os.path.isfile(model_file) else "Internal Virtual/Physical Drive"
                    removable_file = os.path.join(dev_dir, "removable")
                    try:
                        with open(removable_file) as rf:
                            removable = rf.read().strip() == "1"
                    except OSError:
                        removable = False
                    disks.append({
                        "name": b,
                        "path": f"/dev/{b}",
                        "size": f"{size_gb} GB",
                        "model": model,
                        "removable": removable
                    })
                except Exception:
                    pass
        except Exception as e:
            print(f"Error scanning /sys/block: {e}", file=sys.stderr)

    # Internal drives first. Removable ones are listed rather than hidden --
    # some thin clients expose internal eMMC as removable, and hiding those
    # would make the installer useless on that hardware -- but they must never
    # be the default selection in the wizard.
    disks.sort(key=lambda d: (bool(d.get("removable")), d.get("name", "")))
    return disks

def locate_running_image():
    """
    The system image this live session booted from, and its release version.

    The installer copies these exact files onto the disk: the installed system
    then boots the same squashfs, kernel and initrd as the ISO, through
    live-boot, instead of an rsync of the running root (docs/OTA_UPDATES.md
    section 5.1). Everything is checked here, before the disk is touched.
    """
    try:
        with open(IMAGE_VERSION_FILE, "r", encoding="utf-8") as handle:
            version = handle.read().strip()
    except OSError as err:
        raise RuntimeError(f"cannot read the image version from {IMAGE_VERSION_FILE}: {err}") from err
    if not IMAGE_VERSION_PATTERN.match(version):
        raise RuntimeError(f"{IMAGE_VERSION_FILE} holds {version!r}, which is not a release version")

    for directory in LIVE_IMAGE_DIRS:
        if all(os.path.isfile(os.path.join(directory, name)) for name in IMAGE_FILES):
            return directory, version
    raise RuntimeError(
        "the live medium's system image was not found (looked for "
        f"{', '.join(IMAGE_FILES)} in {', '.join(LIVE_IMAGE_DIRS)}). "
        "If this session was started with 'toram', restart from the normal menu "
        "entry to install."
    )


def copy_image_file(source, destination, report):
    """Copy one image file and flush it to disk; report(done_bytes) as it goes."""
    expected = os.path.getsize(source)
    done = 0
    with open(source, "rb") as src, open(destination, "wb") as dst:
        while True:
            chunk = src.read(IMAGE_COPY_CHUNK)
            if not chunk:
                break
            dst.write(chunk)
            done += len(chunk)
            report(done)
        dst.flush()
        os.fsync(dst.fileno())
    if done != expected:
        raise RuntimeError(f"copied {done} of {expected} bytes of {source}")
    os.chmod(destination, 0o644)


def install_to_disk(target_disk, grub_password_hash=None):
    if os.geteuid() != 0:
        raise PermissionError("Installer must run as root")

    if not is_live_session():
        raise RuntimeError("Lab Kiosk OS is already installed on this computer. Re-installation is disabled.")

    if not TARGET_DISK_PATTERN.match(target_disk):
        raise ValueError(
            f"Refusing to install to {target_disk!r}: not a whole-disk device node."
        )

    if not os.path.exists(target_disk):
        raise ValueError(f"Target disk does not exist: {target_disk}")

    # Re-checked here, immediately before wipefs, and not only when the list was
    # built: the caller may have been holding a stale list, and this is the last
    # point at which the running system can still be saved from itself.
    if os.path.basename(target_disk) in live_medium_disks():
        raise RuntimeError(
            f"Refusing to install to {target_disk}: this is the medium the live "
            "session is running from. Choose the computer's internal drive."
        )

    size_bytes = disk_size_bytes(target_disk)
    if size_bytes < MIN_DISK_BYTES:
        raise ValueError(
            f"Refusing to install to {target_disk}: {size_bytes // (1024 * 1024)} MiB is smaller than the "
            f"{MIN_DISK_BYTES // (1024 ** 3)} GiB minimum, which holds two system images."
        )

    # Everything the new disk needs is found before anything is erased, so a
    # broken medium fails here and not halfway through with a wiped disk.
    image_dir, version = locate_running_image()
    for required in (GRUB_CFG_TEMPLATE, BOOT_SLOTS_HELPER):
        if not os.path.isfile(required):
            raise RuntimeError(f"{required} is missing from this image; it cannot install a bootable disk.")

    print(f"[INSTALL] Target disk selected: {target_disk}; system image {version} from {image_dir}",
          file=sys.stderr)
    write_status("running", f"Preparing target disk {target_disk}...", 10)

    write_status("running", "Unmounting target partitions...", 15)
    run_cmd(["swapoff", "-a"], check=False)
    for mount_point in (TARGET_ROOT_MOUNT, TARGET_ESP_MOUNT, TARGET_DATA_MOUNT):
        run_cmd(["umount", "-R", mount_point], check=False)
    for part in range(1, 16):
        p_name = f"{target_disk}p{part}" if ("nvme" in target_disk or "mmcblk" in target_disk) else f"{target_disk}{part}"
        if os.path.exists(p_name):
            run_cmd(["umount", "-f", p_name], check=False)

    write_status("running", "Creating GPT partition table (BIOS & UEFI compatible)...", 20)
    run_cmd(["wipefs", "-a", "-f", target_disk], check=False)
    run_cmd(["parted", "-s", target_disk, "mklabel", "gpt"])
    # Partition 1: BIOS boot partition for legacy GRUB embedding (1MiB - 2MiB)
    run_cmd(["parted", "-s", target_disk, "mkpart", "bios_grub", "1MiB", "2MiB"])
    run_cmd(["parted", "-s", target_disk, "set", "1", "bios_grub", "on"])
    # Partition 2: EFI System Partition (2MiB - 514MiB)
    run_cmd(["parted", "-s", target_disk, "mkpart", "ESP", "fat32", "2MiB", "514MiB"])
    run_cmd(["parted", "-s", target_disk, "set", "2", "esp", "on"])
    # Partition 3: the image store (514MiB - 513MiB from the end). It holds the
    # boot menu and whole system images as files, never a root filesystem:
    #   boot/grub/                grub.cfg, grubenv, the boot-menu password
    #   images/<version>/         filesystem.squashfs, vmlinuz, initrd.img
    # The "--" is required, not stylistic: the end offset is negative (measured
    # back from the end of the disk) and parted's option parser otherwise reads
    # "-513MiB" as a bundle of single-letter flags and aborts.
    run_cmd(["parted", "-s", target_disk, "--", "mkpart", "ROOT", "ext4", "514MiB", "-513MiB"])
    # Partition 4: the only writable-across-reboots area on the machine.
    #
    # The installed system runs from its squashfs under a RAM overlay, so every
    # write to / is gone at power-off. That is the whole point for user state,
    # but it would also discard the device token: a workstation enrolled *after*
    # installation would come back unenrolled on the next boot, with nothing in
    # the UI to say so. /etc/labkiosk is mounted from here instead (by
    # etc-labkiosk.mount in the image), so the enrolment survives while the rest
    # of the OS stays immutable. 512 MiB is far more than the config needs and
    # keeps the partition comfortably alignable.
    run_cmd(["parted", "-s", target_disk, "--", "mkpart", "DATA", "ext4", "-512MiB", "100%"])
    time.sleep(2)
    run_cmd(["partprobe", target_disk], check=False)
    time.sleep(1)

    # Partition 1 is the bios_grub area: it holds no filesystem and is never
    # mounted, so only the ESP, ROOT and DATA node names are needed here.
    is_p_style = "nvme" in target_disk or "mmcblk" in target_disk or target_disk[-1].isdigit()
    part_esp  = f"{target_disk}p2" if is_p_style else f"{target_disk}2"
    part_root = f"{target_disk}p3" if is_p_style else f"{target_disk}3"
    part_data = f"{target_disk}p4" if is_p_style else f"{target_disk}4"

    for _ in range(10):
        if os.path.exists(part_root) and os.path.exists(part_esp) and os.path.exists(part_data):
            break
        time.sleep(0.5)

    write_status("running", "Formatting file systems (FAT32 & ext4)...", 25)
    run_cmd(["mkfs.vfat", "-F", "32", "-n", "ESP", part_esp])
    run_cmd(["mkfs.ext4", "-F", "-L", "LABKIOSK_ROOT", part_root])
    run_cmd(["mkfs.ext4", "-F", "-L", "LABKIOSK_DATA", part_data])

    root_dir = TARGET_ROOT_MOUNT
    esp_dir = TARGET_ESP_MOUNT
    data_dir = TARGET_DATA_MOUNT
    boot_dir = os.path.join(root_dir, "boot")
    grub_dir = os.path.join(boot_dir, "grub")

    def cleanup_mounts():
        run_cmd(["sync"], check=False)
        for mount_point in (data_dir, esp_dir, root_dir):
            run_cmd(["umount", "-R", mount_point], check=False)
            run_cmd(["umount", "-l", mount_point], check=False)
        run_cmd(["sync"], check=False)

    try:
        for device, mount_point in ((part_root, root_dir), (part_esp, esp_dir), (part_data, data_dir)):
            os.makedirs(mount_point, exist_ok=True)
            run_cmd(["mount", device, mount_point])

        # Only root may change the image store; everyone may read it, which is
        # how the agent reads the boot-menu password digest to check the
        # administrator password.
        os.chmod(root_dir, 0o755)

        image_dest = os.path.join(root_dir, "images", version)
        os.makedirs(image_dest, mode=0o755)
        os.chmod(os.path.join(root_dir, "images"), 0o755)
        total = sum(os.path.getsize(os.path.join(image_dir, name)) for name in IMAGE_FILES)
        copied_before = 0
        for name in IMAGE_FILES:
            source = os.path.join(image_dir, name)

            def report(done, base=copied_before):
                percent = 30 + int(40 * (base + done) / max(total, 1))
                write_status("running", f"Copying the Lab Kiosk OS {version} system image to the drive...", percent)

            copy_image_file(source, os.path.join(image_dest, name), report)
            copied_before += os.path.getsize(source)
        print(f"[INSTALL] Copied system image {version} ({total} bytes) to {image_dest}.", file=sys.stderr)

        write_status("running", "Saving network and enrolment settings...", 72)
        seed_data_partition(data_dir)

        write_status("running", "Installing GRUB bootloader to internal storage...", 80)
        uefi_installed = False
        bios_installed = False
        bootloader_errors = []

        # The boot loader is installed from this live session, which carries the
        # same GRUB packages as every image; there is no root filesystem on the
        # disk to chroot into any more. --boot-directory puts grub.cfg and the
        # modules on the image store, outside every image.
        try:
            run_cmd([
                "grub-install",
                "--target=x86_64-efi",
                f"--efi-directory={esp_dir}",
                f"--boot-directory={boot_dir}",
                "--bootloader-id=LabKiosk",
                "--no-nvram",
                "--recheck",
            ], check=True)
            run_cmd([
                "grub-install",
                "--target=x86_64-efi",
                f"--efi-directory={esp_dir}",
                f"--boot-directory={boot_dir}",
                "--removable",
                "--recheck",
            ], check=True)
            uefi_installed = True
        except Exception as err:
            print(f"[INSTALL] WARNING: UEFI bootloader installation failed: {err}", file=sys.stderr)
            bootloader_errors.append(f"UEFI: {err}")

        # Install Legacy BIOS bootloader into MBR / bios_grub
        if not ("nvme" in target_disk or "mmcblk" in target_disk):
            try:
                run_cmd([
                    "grub-install",
                    "--target=i386-pc",
                    f"--boot-directory={boot_dir}",
                    target_disk,
                    "--recheck",
                ], check=True)
                bios_installed = True
            except Exception as err:
                print(f"[INSTALL] WARNING: BIOS bootloader installation failed: {err}", file=sys.stderr)
                bootloader_errors.append(f"BIOS: {err}")

        # Verify at least one bootloader succeeded, or verify boot files exist on ESP
        has_efi_files = False
        efi_check_dir = os.path.join(esp_dir, "EFI")
        if os.path.isdir(efi_check_dir):
            for root, dirs, files in os.walk(efi_check_dir):
                for f in files:
                    if f.lower().endswith(".efi"):
                        has_efi_files = True
                        break
                if has_efi_files:
                    break

        if not (uefi_installed or bios_installed or has_efi_files):
            raise RuntimeError(
                "Bootloader installation failed (both UEFI and BIOS failed, and no EFI binaries found on ESP). "
                f"Details: {'; '.join(bootloader_errors)}"
            )

        write_status("running", "Configuring the boot menu...", 90)
        # One menu for every image: it reads which one to boot from grubenv, so
        # an update never has to regenerate it.
        os.makedirs(grub_dir, exist_ok=True)
        shutil.copyfile(GRUB_CFG_TEMPLATE, os.path.join(grub_dir, "grub.cfg"))
        os.chmod(os.path.join(grub_dir, "grub.cfg"), 0o644)
        write_grub_password(grub_dir, grub_password_hash)
        write_data_partition_id(grub_dir, part_data)

        proc = subprocess.run(
            [BOOT_SLOTS_HELPER, "init", version, "--boot-dir", grub_dir],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        for line in proc.stderr.strip().splitlines():
            print(f"[INSTALL] {line}", file=sys.stderr)
        if proc.returncode != 0:
            raise RuntimeError(f"could not write the boot environment: {proc.stdout.strip() or proc.returncode}")

        write_status("running", "Finalizing and synchronizing storage...", 95)
    finally:
        cleanup_mounts()

    write_status("completed", "Lab Kiosk OS successfully installed to internal drive!", 100)
    print("[INSTALL] SUCCESS! Installation complete.", file=sys.stderr)


def disk_size_bytes(target_disk):
    size_file = os.path.join("/sys/class/block", os.path.basename(target_disk), "size")
    try:
        with open(size_file, "r") as handle:
            return int(handle.read().strip()) * 512
    except (OSError, ValueError) as err:
        raise RuntimeError(f"cannot read the size of {target_disk}: {err}") from err


def copy_regular_file(source, destination):
    """
    Copy source if it is a regular file, never through a symlink.

    This runs as root (kiosk may start the installer through sudo) over
    /etc/labkiosk, which kiosk owns: a link planted there, say to /etc/shadow,
    must not be read as root and handed back to kiosk on the data partition.
    O_NOFOLLOW and fstat on the open file leave no window to swap one in.
    Returns False for anything that is not a regular file.
    """
    try:
        fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as err:
        if err.errno == errno.ELOOP:
            print(f"[INSTALL] Skipped {source}: a symbolic link, not a file.", file=sys.stderr)
            return False
        raise
    with os.fdopen(fd, "rb") as src:
        info = os.fstat(src.fileno())
        if not stat.S_ISREG(info.st_mode):
            return False
        with open(destination, "wb") as dst:
            shutil.copyfileobj(src, dst)
        os.chmod(destination, stat.S_IMODE(info.st_mode))
        os.utime(destination, ns=(info.st_atime_ns, info.st_mtime_ns))
    return True


def seed_data_partition(data_dir):
    """
    Carry the live session's enrolment and network profiles onto LABKIOSK_DATA.

    Without this, installing a workstation that was enrolled from the live
    session would produce a machine that boots up unenrolled.
    """
    source_config_dir = "/etc/labkiosk"
    data_conn_dir = os.path.join(data_dir, "system-connections")
    os.makedirs(data_conn_dir, exist_ok=True)
    os.chmod(data_conn_dir, 0o700)
    os.chown(data_conn_dir, 0, 0)

    # Carry the NetworkManager profiles configured in the live session (Wi-Fi
    # keys included) onto the data partition, which the installed system
    # bind-mounts over /etc/NetworkManager/system-connections: under the RAM
    # overlay that is the only place a profile survives a reboot.
    nm_dirs = ["/etc/NetworkManager/system-connections", os.path.join(source_config_dir, "system-connections")]
    for nm_dir in nm_dirs:
        if os.path.isdir(nm_dir):
            for entry in os.listdir(nm_dir):
                src_conn = os.path.join(nm_dir, entry)
                dst_conn = os.path.join(data_conn_dir, entry)
                if copy_regular_file(src_conn, dst_conn):
                    os.chmod(dst_conn, 0o600)
                    os.chown(dst_conn, 0, 0)
                    print(f"[INSTALL] Carried NetworkManager connection {entry} onto data partition.",
                          file=sys.stderr)

    # The proxy is deliberately not written into /etc/environment: proxy.json
    # is carried onto this partition here, and the agent applies it to itself
    # and to Chromium's policy at every start. Language, region, timezone and
    # keyboard travel the same way, in localization.json: the agent re-applies
    # them at every start (apply_saved_localization()), so nothing is written
    # into a system image, which an update replaces.
    if os.path.isdir(source_config_dir):
        stat_info = os.stat(source_config_dir)
        for entry in os.listdir(source_config_dir):
            src = os.path.join(source_config_dir, entry)
            dest = os.path.join(data_dir, entry)
            if not copy_regular_file(src, dest):
                continue
            # The copy carries the mode (0600) but not the owner, and this runs as
            # root -- so without this chown the agent, which runs as the kiosk
            # user, could not read back the very config it just enrolled with.
            os.chown(dest, stat_info.st_uid, stat_info.st_gid)
            print(f"[INSTALL] Carried enrolment file {entry} onto the data partition.",
                  file=sys.stderr)
        os.chown(data_dir, stat_info.st_uid, stat_info.st_gid)
    os.chmod(data_dir, 0o700)

    # Prove the kiosk user can actually write here, rather than letting the
    # workstation discover it at enrolment with a bare "Permission denied"
    # on a machine that has no shell to investigate it from.
    probe = os.path.join(data_dir, ".labkiosk-write-probe")
    probe_result = subprocess.run(
        ["runuser", "-u", "kiosk", "--", "touch", probe],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    if probe_result.returncode != 0:
        owner = os.stat(data_dir)
        raise RuntimeError(
            f"the data partition is not writable by the kiosk user "
            f"(owned by {owner.st_uid}:{owner.st_gid}, mode {owner.st_mode & 0o777:04o}): "
            f"{probe_result.stderr.strip()}"
        )
    os.unlink(probe)
    print("[INSTALL] Verified the kiosk user can write to the data partition.", file=sys.stderr)


def write_grub_password(grub_dir, grub_password_hash):
    """
    Boot-menu password for THIS installation.

    Deliberately applied here rather than baked into the ISO. A hash compiled
    into the image would be one password shared by every customer who ever
    received that ISO: a leak anywhere would compromise all of them, and it
    could not be rotated on machines already deployed. Applying it per
    installation keeps the image free of secrets and gives each site its own.

    It lives in boot/grub on the image store, outside every system image, so an
    update keeps it. grub.cfg sources it; the agent reads the same digest to
    check the administrator password (GRUB_PASSWORD_FILE in agent.py).

    Booting stays unattended either way: every entry in grub.cfg is
    --unrestricted, so `set superusers` gates only the edit (`e`) and
    command-line (`c`) keys.
    """
    password_file = os.path.join(grub_dir, GRUB_PASSWORD_FILE_NAME)
    if grub_password_hash:
        with open(password_file, "w") as handle:
            handle.write('set superusers="labkiosk"\n')
            handle.write(f"password_pbkdf2 labkiosk {grub_password_hash}\n")
        os.chmod(password_file, 0o644)
        print("[INSTALL] Boot-menu password applied to the installed system.", file=sys.stderr)
    else:
        print(
            "[INSTALL] WARNING: no boot-menu password supplied. A user at the keyboard "
            "can edit the GRUB entry and boot with init=/bin/sh.",
            file=sys.stderr,
        )


def write_data_partition_id(grub_dir, part_data):
    """
    Pin /etc/labkiosk to THIS disk's data partition.

    grub.cfg sources the file and passes labkiosk.data=<uuid> to the kernel;
    labkiosk-data-generator mounts exactly that UUID. Mounting by label would
    let any USB stick formatted as LABKIOSK_DATA supply the agent's enrolment,
    proxy and Wi-Fi profiles. Like the boot password it lives in boot/grub,
    outside every system image, so an update keeps it.
    """
    data_uuid = run_cmd(["blkid", "-s", "UUID", "-o", "value", part_data])
    if not FS_UUID_PATTERN.match(data_uuid):
        raise RuntimeError(f"blkid returned no usable UUID for the data partition ({part_data}): {data_uuid!r}")
    id_file = os.path.join(grub_dir, DATA_ID_FILE_NAME)
    with open(id_file, "w") as handle:
        handle.write(f'set data_uuid="{data_uuid}"\n')
    os.chmod(id_file, 0o644)
    print(f"[INSTALL] Data partition pinned by UUID {data_uuid}.", file=sys.stderr)


if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(
        description="Lab Kiosk OS - Automated Local Disk Installer",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--list-disks", action="store_true", help="List candidate storage drives")
    group.add_argument("--status", action="store_true", help="Get current installation status")
    group.add_argument("--target", help="Target disk to install to (e.g., /dev/sda)")
    parser.add_argument(
        "--grub-password-hash",
        help="GRUB PBKDF2 password hash (grub.pbkdf2.sha512...)",
    )

    args = parser.parse_args()

    if args.grub_password_hash and not args.target:
        parser.error("--grub-password-hash requires --target")

    if args.list_disks:
        print(json.dumps(list_disks()))
        sys.exit(0)
    elif args.status:
        print(json.dumps(get_status()))
        sys.exit(0)
    elif args.target:
        grub_hash = args.grub_password_hash
        if grub_hash and not GRUB_PBKDF2_PATTERN.match(grub_hash):
            print(
                "[INSTALL] ERROR: --grub-password-hash is not a grub-mkpasswd-pbkdf2 "
                "digest (expected 'grub.pbkdf2.sha512.<rounds>.<salt>.<hash>').",
                file=sys.stderr,
            )
            sys.exit(1)
        try:
            install_to_disk(args.target, grub_hash)
            sys.exit(0)
        except Exception as err:
            print(f"[INSTALL] ERROR: {err}", file=sys.stderr)
            write_status("error", "Installation failed", 0, str(err))
            sys.exit(1)

#!/bin/bash
# Openbox Autostart Script for Lab Kiosk

# 1. Screen blanking, the screensaver and DPMS power-saving are disabled in the
#    X server itself (BlankTime/StandbyTime/SuspendTime/OffTime = 0 in
#    /etc/X11/xorg.conf.d/10-kiosk-lockdown.conf, written by
#    01-lockdown.hook.chroot). That replaces `xset`, whose package pulls in the
#    C preprocessor for xrdb and nothing the kiosk uses.

# 2. Hide mouse cursor after 5 seconds of inactivity
which unclutter >/dev/null 2>&1 && unclutter -idle 5 -root &

# 3. Remote classroom management: x11vnc behind a per-boot password.
#    The VNC gateway is deliberately NOT published on the LAN. It listens on
#    loopback only and is reached through the Cloudflare Tunnel, because an
#    open noVNC port gives anyone on the school Wi-Fi full keyboard and mouse
#    control of the workstation.
VNC_SECRET_DIR=/tmp/labkiosk
mkdir -p "$VNC_SECRET_DIR"
chmod 700 "$VNC_SECRET_DIR"
VNC_PASSWD_FILE="$VNC_SECRET_DIR/vnc.pass"

VNC_SECRET_FILE="$VNC_SECRET_DIR/vnc.secret"

if [ ! -f "$VNC_PASSWD_FILE" ]; then
  # A fresh random password each boot; nothing persists across reboots because
  # the root filesystem is a RAM overlay anyway. The plaintext is kept in RAM,
  # readable only by the kiosk user, so the agent can report it to the teacher
  # console over the authenticated telemetry channel: without that the
  # console had no way to open a remote-control session at all.
  VNC_SECRET="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-8)"
  x11vnc -storepasswd "$VNC_SECRET" "$VNC_PASSWD_FILE" >/dev/null 2>&1
  chmod 600 "$VNC_PASSWD_FILE"
  (umask 077 && printf '%s' "$VNC_SECRET" > "$VNC_SECRET_FILE")
  unset VNC_SECRET
fi

# -noclipboard: the VNC clipboard is bidirectional, so without it anything a
#   student copies on the workstation is readable by whoever holds a session,
#   and anything in the viewer's clipboard can be pasted into the kiosk.
# -nocmd: disables x11vnc's own remote control channel, which is not used here.
# The VNC protocol truncates passwords to 8 characters, so the secret below is
# a low-entropy credential by construction -- the tunnel in front of it has to
# carry the real authentication. See docs/REMOTE_CONTROL.md.
x11vnc -display :0 -forever -shared -rfbport 5900 -localhost \
  -rfbauth "$VNC_PASSWD_FILE" -noclipboard -nocmd -quiet -bg

# 4. noVNC websockify gateway, bound to loopback for the tunnel to pick up.
if [ -d "/usr/share/novnc" ]; then
  websockify --web=/usr/share/novnc/ 127.0.0.1:6080 localhost:5900 >/dev/null 2>&1 &
fi

# 5. Lab Kiosk telemetry & sync agent, under a supervisor.
#    Logs go to /tmp (RAM) so nothing is written to the read-only rootfs.
#
#    The loop is the point. The agent is the only thing that reports telemetry,
#    applies the teacher's lock curtain, syncs the Chromium allowlist and
#    carries out remote commands. Started bare with `&`, a single crash left the
#    workstation looking fine to the student and invisible to the teacher until
#    someone physically power-cycled it. Restarting costs nothing: the agent is
#    stateless apart from /etc/labkiosk/config.json, which it re-reads at start.
(
  while true; do
    python3 /opt/labkiosk/agent/agent.py >>/tmp/lab-agent.log 2>&1
    echo "[autostart] agent exited; restarting in 2s" >>/tmp/lab-agent.log
    sleep 2
  done
) &

# 6. Wait for the agent's local API, then open whatever it says the target is:
#    the first-boot setup wizard when unconfigured, the school portal once
#    enrolled. Without this the browser would race ahead to a default homepage
#    and the setup wizard would never be seen.
#    It is re-read on every relaunch, so when the agent restarts the browser
#    after enrolment the new session lands on the school's page under the
#    freshly written Chromium policy.
read_kiosk_url() {
  for _ in $(seq 1 50); do
    TARGET="$(curl -fsS --max-time 1 http://127.0.0.1:8888/api/status 2>/dev/null \
      | sed -n 's/.*"targetUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    if [ -n "$TARGET" ]; then
      printf '%s' "$TARGET"
      return 0
    fi
    sleep 0.2
  done
  printf '%s' "http://127.0.0.1:8888/setup"
}

# 7. Infinite watchdog for the Chromium kiosk window.
while true; do
  # Clean ephemeral cache before launch to guarantee a fresh session
  rm -rf /tmp/chromium-cache /tmp/chromium-profile
  KIOSK_URL="$(read_kiosk_url)"

  # NOTE: --disable-web-security is deliberately absent. It was previously set
  # here, which disabled the same-origin policy for every site a student
  # visited. Nothing in this project needs it; the kiosk browses top-level
  # pages rather than framing them.
  chromium \
    --kiosk \
    --no-first-run \
    --noerrdialogs \
    --disable-infobars \
    --disable-pinch \
    --disable-session-crashed-bubble \
    --overscroll-history-navigation=0 \
    --disable-features=TranslateUI \
    --disk-cache-dir=/tmp/chromium-cache \
    --user-data-dir=/tmp/chromium-profile \
    --enable-gpu-rasterization \
    --ignore-gpu-blocklist \
    --load-extension=/opt/labkiosk/extension \
    --disable-extensions-except=/opt/labkiosk/extension \
    --autoplay-policy=no-user-gesture-required \
    -- "$KIOSK_URL"

  sleep 1
done &

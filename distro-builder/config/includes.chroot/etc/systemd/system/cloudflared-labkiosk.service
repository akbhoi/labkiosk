[Unit]
Description=Cloudflare Tunnel for Lab Kiosk Remote Control (provisioned by the organization's console)
Documentation=file:///opt/labkiosk/agent/agent.py
After=network-online.target
Wants=network-online.target
# The token lives on LABKIOSK_DATA on an installed disk.
RequiresMountsFor=/etc/labkiosk
# The agent writes the run token the control plane created for this
# workstation (GET /api/devices/tunnel); an empty file means "no tunnel".
ConditionFileNotEmpty=/etc/labkiosk/tunnel.token

[Service]
Type=simple
# The token file belongs to the kiosk user, so a compromised kiosk session could
# point it at a tunnel of its own choosing. Nothing that tunnel can be told to
# forward to may therefore be anything the kiosk user cannot reach already: the
# process runs as a throwaway unprivileged user, and systemd (as root) hands it
# a private copy of the token instead of the file.
DynamicUser=yes
LoadCredential=token:/etc/labkiosk/tunnel.token
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file %d/token
Restart=always
RestartSec=5

# Sandboxing, as cloudflared-kiosk.service: an outbound connection to
# Cloudflare proxied to a loopback HTTP port needs nothing more.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
InaccessiblePaths=/etc/labkiosk

[Install]
WantedBy=multi-user.target

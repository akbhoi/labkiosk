#!/bin/sh
# Lab Kiosk OS -- mount LABKIOSK_DATA at /etc/labkiosk on an installed disk.
#
# The installed system boots the same squashfs as the ISO, so no
# installer-written /etc/fstab exists (docs/OTA_UPDATES.md section 5.1). The
# data partition is pinned by the UUID the installer recorded for *this* disk
# (boot/grub/labkiosk-data.cfg), which grub.cfg passes as labkiosk.data=<uuid>.
# Never by label: any USB stick can carry the label LABKIOSK_DATA, win the
# by-label link and hand the agent its enrolment, proxy and Wi-Fi profiles.
#
# No valid UUID means no mount unit: /etc/labkiosk stays unmounted and
# labkiosk-data-permissions reports it, rather than trusting some other disk.
set -eu

NORMAL_DIR="${1:?usage: labkiosk-data-generator NORMAL_DIR [EARLY_DIR LATE_DIR]}"
CMDLINE_FILE=/proc/cmdline

installed=0
data_uuid=""
set -f
for arg in $(cat "$CMDLINE_FILE"); do
    case "$arg" in
        labkiosk.installed=1) installed=1 ;;
        labkiosk.data=*) data_uuid="${arg#labkiosk.data=}" ;;
    esac
done
set +f

# A live session, including one booted to reinstall a machine, never mounts
# the internal disk's data partition.
if [ "$installed" != 1 ]; then
    exit 0
fi

if ! printf '%s\n' "$data_uuid" | grep -Eqx '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'; then
    echo "labkiosk-data-generator: no valid labkiosk.data=<uuid> on the kernel command line; /etc/labkiosk stays unmounted." >&2
    exit 0
fi

cat > "$NORMAL_DIR/etc-labkiosk.mount" << EOF
# Generated by labkiosk-data-generator from labkiosk.data= on the kernel command line.
[Unit]
Description=Lab Kiosk persistent data partition (LABKIOSK_DATA)
SourcePath=/proc/cmdline

[Mount]
What=/dev/disk/by-uuid/$data_uuid
Where=/etc/labkiosk
Type=ext4
Options=defaults,nofail
EOF

mkdir -p "$NORMAL_DIR/local-fs.target.wants"
ln -sf ../etc-labkiosk.mount "$NORMAL_DIR/local-fs.target.wants/etc-labkiosk.mount"

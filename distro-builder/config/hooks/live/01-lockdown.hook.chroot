#!/bin/sh
set -e

echo "[Hook] Applying Lab Kiosk Lockdown, Display & User Setup..."

# The cloudflared release to install is pinned in
# config/includes.chroot/usr/share/labkiosk/cloudflared.pin. A binary is only
# installed when both a version and its SHA-256 are pinned there.
CLOUDFLARED_PIN="/usr/share/labkiosk/cloudflared.pin"

# 1. Create the unprivileged kiosk user and fallback live user.
#    All virtual terminals (getty) are masked and SSH is absent, so passwordless
#    login is securely restricted to the local nodm auto-display session.
for u in kiosk user; do
    if ! id -u "$u" >/dev/null 2>&1; then
        useradd -m -s /bin/bash -G audio,video,input,render,tty "$u"
    else
        usermod -a -G audio,video,input,render,tty "$u" || true
    fi
    passwd -d "$u" || true

    mkdir -p "/home/$u/.config/openbox"
    cat << 'EOF' > "/home/$u/.xsession"
#!/bin/sh
exec /usr/bin/openbox-session
EOF
    chmod 755 "/home/$u/.xsession"
    cp /etc/openbox/autostart "/home/$u/.config/openbox/autostart"
    chmod 755 "/home/$u/.config/openbox/autostart"
    chown -R "$u:$u" "/home/$u"
done
passwd -l root || true

# Pre-seed live-config so it does not overwrite nodm or create duplicate users
mkdir -p /var/lib/live/config
touch /var/lib/live/config/nodm
touch /var/lib/live/config/user-setup

mkdir -p /etc/live
cat << 'EOF' > /etc/live/config.conf
LIVE_USERNAME="kiosk"
LIVE_USER_DEFAULT_GROUPS="audio,video,input,render,tty"
EOF

# 2. Configure X11 permissions and nodm autologin display manager.
#    rootless Xorg requires xserver-xorg-legacy with needs_root_rights=yes to run
#    smoothly across varied display hardware (including Hyper-V and VirtualBox).
mkdir -p /etc/X11
cat << 'EOF' > /etc/X11/Xwrapper.config
allowed_users=anybody
needs_root_rights=yes
EOF
chmod u+s /usr/lib/xorg/Xorg.wrap 2>/dev/null || true
echo "/usr/sbin/nodm" > /etc/X11/default-display-manager

# Configure PAM for nodm to guarantee autologin succeeds without account lock checks
mkdir -p /etc/pam.d
cat << 'EOF' > /etc/pam.d/nodm
#%PAM-1.0
auth    required    pam_permit.so
account required    pam_permit.so
password required   pam_permit.so
session required    pam_permit.so
EOF

mkdir -p /etc/default
cat << 'EOF' > /etc/default/nodm
NODM_ENABLED=true
NODM_USER=kiosk
NODM_XSESSION=/home/kiosk/.xsession
NODM_MIN_SESSION_TIME=2
NODM_X_OPTIONS=":0 -nolisten tcp"
EOF

# 3. Ownership so the agent can do its job as the kiosk user.
chmod +x /etc/openbox/autostart || true
chmod +x /opt/labkiosk/agent/agent.py || true
chmod +x /usr/local/bin/labkiosk-install || true
chown -R kiosk:kiosk /opt/labkiosk || true
chown -R kiosk:kiosk /etc/openbox || true

#    The agent rewrites Chromium's managed policy whenever the school's
#    allowlist changes. Without this the directory stays root-owned and every
#    policy sync fails silently, freezing the allowlist at its boot-time value.
mkdir -p /etc/chromium/policies/managed
chown -R kiosk:kiosk /etc/chromium/policies/managed

#    The agent's enrolment config holds a device bearer token.
mkdir -p /etc/labkiosk
chown kiosk:kiosk /etc/labkiosk
chmod 700 /etc/labkiosk

# 4. Mask virtual terminals so Ctrl+Alt+F1..F6 cannot reach a login prompt.
for tty in 1 2 3 4 5 6; do
    systemctl mask "getty@tty${tty}.service" || true
done
systemctl mask serial-getty@.service || true
systemctl mask debug-shell.service || true

# Mask NetworkManager-wait-online to prevent 120s boot stalls when network is offline/slow.
systemctl mask NetworkManager-wait-online.service || true

# 5. Stop the X server from switching VTs or being killed with Ctrl+Alt+Backspace.
#    Masked gettys hide the login prompt; this removes the escape itself.
mkdir -p /etc/X11/xorg.conf.d
cat << 'EOF' > /etc/X11/xorg.conf.d/10-kiosk-lockdown.conf
Section "ServerFlags"
    Option "DontVTSwitch" "true"
    Option "DontZap"      "true"
    Option "BlankTime"    "0"
    Option "StandbyTime"  "0"
    Option "SuspendTime"  "0"
    Option "OffTime"      "0"
EndSection
EOF

# 6. Allow the kiosk user to reboot and power off, and nothing else.
#    These are the only privileged actions the agent performs; without a rule it
#    runs as an unprivileged user and the teacher's shutdown command silently
#    does nothing.
mkdir -p /etc/polkit-1/rules.d
cat << 'EOF' > /etc/polkit-1/rules.d/50-labkiosk-power.rules
polkit.addRule(function(action, subject) {
    if (subject.user !== "kiosk") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.reboot-multiple-sessions" ||
        action.id === "org.freedesktop.login1.power-off" ||
        action.id === "org.freedesktop.login1.power-off-multiple-sessions") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
EOF

# Sudoers permissions for the guided disk installer.
mkdir -p /etc/sudoers.d
cat << 'EOF' > /etc/sudoers.d/50-labkiosk-install
kiosk ALL=(ALL) NOPASSWD: /usr/local/bin/labkiosk-install
EOF
chmod 0440 /etc/sudoers.d/50-labkiosk-install

# 7. Enable kiosk services.
systemctl enable nodm.service || true
systemctl enable cloudflared-kiosk.service || true

# Configure Hyper-V & generic VM display/storage drivers in initramfs
mkdir -p /etc/initramfs-tools
cat << 'EOF' >> /etc/initramfs-tools/modules
hv_vmbus
hv_storvsc
hv_netvsc
hyperv_fb
hyperv_keyboard
EOF
update-initramfs -u || true


# 8. Install cloudflared, but only from a pinned, checksum-verified release.
CLOUDFLARED_VERSION=""
CLOUDFLARED_SHA256=""
if [ -f "$CLOUDFLARED_PIN" ]; then
    CLOUDFLARED_VERSION="$(sed -n 's/^VERSION=//p' "$CLOUDFLARED_PIN" | tr -d '[:space:]')"
    CLOUDFLARED_SHA256="$(sed -n 's/^SHA256=//p' "$CLOUDFLARED_PIN" | tr -d '[:space:]')"
fi

if [ -f /usr/local/bin/cloudflared ]; then
    echo "[Hook] cloudflared already present; leaving it untouched."
elif [ -z "$CLOUDFLARED_VERSION" ] || [ -z "$CLOUDFLARED_SHA256" ]; then
    echo "[Hook] No cloudflared release pinned in $CLOUDFLARED_PIN."
    echo "[Hook] Building without the Cloudflare Tunnel binary. Remote control over"
    echo "[Hook] the tunnel will be unavailable until a release is pinned; see that"
    echo "[Hook] file for instructions."
else
    echo "[Hook] Downloading cloudflared ${CLOUDFLARED_VERSION}..."
    DOWNLOAD_URL="https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64"
    if ! curl -fsSL "$DOWNLOAD_URL" -o /tmp/cloudflared; then
        echo "[Hook] ERROR: could not download cloudflared from $DOWNLOAD_URL" >&2
        exit 1
    fi

    ACTUAL_SHA="$(sha256sum /tmp/cloudflared | cut -d' ' -f1)"
    if [ "$ACTUAL_SHA" != "$CLOUDFLARED_SHA256" ]; then
        echo "[Hook] ERROR: cloudflared checksum mismatch." >&2
        echo "[Hook]   expected: $CLOUDFLARED_SHA256" >&2
        echo "[Hook]   actual:   $ACTUAL_SHA" >&2
        echo "[Hook] Refusing to ship an unverified binary." >&2
        rm -f /tmp/cloudflared
        exit 1
    fi

    install -m 0755 /tmp/cloudflared /usr/local/bin/cloudflared
    rm -f /tmp/cloudflared
fi

echo "[Hook] Lockdown configuration applied successfully."

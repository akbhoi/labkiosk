#!/bin/sh
set -e

echo "[Hook] Applying Lab Kiosk Lockdown, Display & User Setup..."

# 1. Create the unprivileged kiosk user.
#    All virtual terminals (getty) are masked and SSH is absent, so passwordless
#    login is securely restricted to the local kiosk session
#    (labkiosk-session.service).
#
#    Not in the `tty` group: that group may write to every terminal, which a
#    browser escape would get for free, and nothing in the session needs it.
#    The X server's own terminal, tty7, is handed to the kiosk user by
#    labkiosk-session.service, and to nobody else.
#
#    There used to be a second account here, `user`, described as a fallback.
#    Nothing could ever log into it: the session is pinned to User=kiosk, there is
#    no getty and no SSH, and live-config's user-setup is pre-seeded away below
#    so it never creates one either. It was an unreachable account carrying an
#    empty password and membership of input/video/tty, so it is gone.
#
#    `passwd -d` (empty) rather than `passwd -l` (locked) is deliberate and must
#    stay: a locked kiosk account previously deadlocked the display manager's
#    PAM stack (nodm's, before labkiosk-session) and produced a black screen on
#    boot. See the pitfall table in AGENTS.md. What
#    makes that acceptable is that no PAM service can be reached to use the empty
#    password -- every getty is masked, serial-getty and debug-shell are masked,
#    and there is no SSH server in the image.
KIOSK_USER="kiosk"
KIOSK_HOME="/home/$KIOSK_USER"

if ! id -u "$KIOSK_USER" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -G audio,video,input,render "$KIOSK_USER"
else
    usermod -a -G audio,video,input,render "$KIOSK_USER" || true
fi
# Not "|| true": an image whose kiosk user can write to every terminal must not
# be built.
if id -nG "$KIOSK_USER" | tr ' ' '\n' | grep -qx tty; then
    gpasswd -d "$KIOSK_USER" tty
fi
passwd -d "$KIOSK_USER" || true

mkdir -p "$KIOSK_HOME/.config/openbox"
cat << 'EOF' > "$KIOSK_HOME/.xsession"
#!/bin/sh
exec /usr/bin/openbox-session
EOF
chmod 755 "$KIOSK_HOME/.xsession"
cp /etc/openbox/autostart "$KIOSK_HOME/.config/openbox/autostart"
chmod 755 "$KIOSK_HOME/.config/openbox/autostart"

# THE KEYBINDINGS ONLY APPLY FROM A PATH OPENBOX ACTUALLY READS.
#
# openbox-session looks for rc.xml in ~/.config/openbox and then in
# /etc/xdg/openbox. It does NOT read /etc/openbox/rc.xml, which is where this
# project kept its stripped configuration -- so every installed workstation was
# running Debian's default bindings instead: Alt+Tab, Alt+F4, Super+E,
# Ctrl+Alt+arrow desktop switching and a root menu on right click. The simulator
# hid it, because its entrypoint passes --config-file explicitly.
#
# Installed in both places on purpose. The home copy is what Openbox uses; the
# one under /etc/xdg is what it falls back on if the home directory is ever
# rebuilt, so a kiosk cannot come up with the distribution defaults again.
mkdir -p /etc/xdg/openbox
cp /etc/openbox/rc.xml /etc/xdg/openbox/rc.xml
cp /etc/openbox/rc.xml "$KIOSK_HOME/.config/openbox/rc.xml"
chmod 644 /etc/xdg/openbox/rc.xml "$KIOSK_HOME/.config/openbox/rc.xml"
chown -R "$KIOSK_USER:$KIOSK_USER" "$KIOSK_HOME"

passwd -l root || true

# Pre-seed live-config so it does not set up a display manager (nodm, before
# labkiosk-session; no longer installed) or create duplicate users.
#
# sudo and policykit are pre-seeded for the same reason, and they matter more:
# live-config's 0040-sudo appends "kiosk ALL=(ALL) NOPASSWD: ALL" to
# /etc/sudoers.d/live, and 1080-policykit grants that user every polkit action,
# at every boot. That would hand the browser's own uid a root shell -- on the
# live ISO, and on every installed disk, which boots its system image through
# live-boot as well (docs/OTA_UPDATES.md section 5.1). The kiosk user's only
# root paths are the sudoers and polkit rules this hook writes below.
mkdir -p /var/lib/live/config
touch /var/lib/live/config/nodm
touch /var/lib/live/config/user-setup
touch /var/lib/live/config/sudo
touch /var/lib/live/config/policykit

mkdir -p /etc/live
cat << 'EOF' > /etc/live/config.conf
LIVE_USERNAME="kiosk"
LIVE_USER_DEFAULT_GROUPS="audio,video,input,render"
EOF

# 2. The kiosk session: X started by the kiosk user, not by root.
#
#    labkiosk-session.service runs xinit as kiosk in a logind session on tty7,
#    in place of nodm, which started the X server itself as root. Xorg.wrap
#    then keeps root only where it has to: needs_root_rights=auto runs the
#    server as kiosk whenever the graphics have a kernel modesetting driver
#    (Intel, AMD, nouveau, Hyper-V's and QEMU's), and as root only on the rest,
#    such as plain VESA. allowed_users=console: only a process on a virtual
#    console -- the session's tty7 -- may start it at all.
mkdir -p /etc/X11
cat << 'EOF' > /etc/X11/Xwrapper.config
allowed_users=console
needs_root_rights=auto
EOF
# Not "|| true": without the setuid bit the machines that need root for X get a
# black screen.
chmod u+s /usr/lib/xorg/Xorg.wrap

# The session's PAM stack. `auth` and `account` are permitted outright because
# the session is for a user fixed in the unit: there is no password to check
# and no prompt for anyone to answer.
#
# `password` is pam_deny rather than pam_permit. Nothing should ever change a
# credential through the autologin stack, and pam_permit there reports success
# without doing anything -- a silent no-op that looks like it worked.
#
# `session` registers the session with logind (pam_systemd). That is what
# gives the kiosk user the graphics card and input devices of tty7's seat, and
# without it a rootless X server cannot start. Nothing else is in the session
# stack: a locked-down one there is what previously deadlocked the display
# manager into a black screen on boot.
mkdir -p /etc/pam.d
cat << 'EOF' > /etc/pam.d/labkiosk-session
#%PAM-1.0
auth     required   pam_permit.so
account  required   pam_permit.so
password required   pam_deny.so
session  required   pam_systemd.so class=user type=x11
EOF
rm -f /etc/X11/default-display-manager /etc/pam.d/nodm /etc/default/nodm
# Not "|| true": a kiosk that boots to a text console is no kiosk.
if [ ! -x /usr/bin/xinit ] || [ ! -f /lib/x86_64-linux-gnu/security/pam_systemd.so ]; then
    echo "[Hook] ERROR: xinit or pam_systemd is missing; the kiosk session cannot start." >&2
    exit 1
fi

# 3. Ownership so the agent can do its job as the kiosk user.
#
#    /opt/labkiosk and /etc/openbox stay root-owned and world-readable. They
#    used to be chowned to kiosk, which handed the browser's own uid write
#    access to the agent, the setup wizard, and the extension directory that
#    Chromium loads with --load-extension: anything achieving code execution as
#    kiosk could then rewrite the kiosk's own enforcement. The agent only reads
#    from these paths. The two it genuinely writes to are granted below.
chmod +x /etc/openbox/autostart || true
# Not "|| true": the session runs the agent as a program (etc/openbox/autostart).
chmod 0755 /opt/labkiosk/agent/agent.py
chmod +x /usr/local/bin/labkiosk-install || true
chmod +x /usr/local/sbin/labkiosk-localization || true
chmod +x /usr/local/sbin/labkiosk-boot-slots || true
chmod +x /usr/local/sbin/labkiosk-update || true
chmod +x /usr/local/sbin/labkiosk-share || true
# Not "|| true": without them the journal never reaches the data partition and
# the swap partition is never used.
chmod 0755 /usr/local/sbin/labkiosk-logs /usr/local/sbin/labkiosk-swap /usr/local/sbin/labkiosk-hostname \
    /usr/local/sbin/labkiosk-data-unlock /usr/local/sbin/labkiosk-health
# Not "|| true": without it a power schedule never switches a workstation on.
chmod 0755 /usr/local/sbin/labkiosk-wake-alarm
# Not "|| true": without it nothing mounts the data partition on an installed disk.
chmod 0755 /etc/systemd/system-generators/labkiosk-data-generator
chmod +x /usr/local/bin/labkiosk-lock-keys || true
chown -R root:root /opt/labkiosk || true
chmod -R go-w /opt/labkiosk || true
chown -R root:root /etc/openbox || true
chmod -R go-w /etc/openbox || true

#    The agent rewrites Chromium's managed policy whenever the organization's
#    allowlist changes. Without this the directory stays root-owned and every
#    policy sync fails silently, freezing the allowlist at its boot-time value.
mkdir -p /etc/chromium/policies/managed
chown -R kiosk:kiosk /etc/chromium/policies/managed

#    Generate the boot-time managed policy from the single base declaration in
#    /usr/share/labkiosk/chromium-policy-base.json. The agent reloads that same
#    base on every allowlist change, so the boot-time policy and the enrolled
#    policy cannot drift apart. Only the three per-workstation keys are added
#    here; until a workstation enrols, the only reachable page is the local
#    setup wizard.
POLICY_BASE="/usr/share/labkiosk/chromium-policy-base.json"
if [ ! -f "$POLICY_BASE" ]; then
    echo "[Hook] ERROR: $POLICY_BASE is missing; refusing to ship an unpoliced browser." >&2
    exit 1
fi
python3 - "$POLICY_BASE" /etc/chromium/policies/managed/policies.json <<'PYEOF'
import json
import sys

base_path, out_path = sys.argv[1], sys.argv[2]
with open(base_path, "r", encoding="utf-8") as handle:
    policy = json.load(handle)

setup_url = "http://127.0.0.1:8888/setup"
policy["HomepageLocation"] = setup_url
policy["NewTabPageLocation"] = setup_url
policy["URLAllowlist"] = ["127.0.0.1", "localhost", "file:///opt/labkiosk/*"]

with open(out_path, "w", encoding="utf-8") as handle:
    # print() supplies the trailing newline. Deliberately not handle.write()
    # with an escape: this block travels through a shell heredoc, where a
    # backslash escape is easy to mangle into a real newline and produce an
    # unterminated string literal that only shows up mid-ISO-build.
    print(json.dumps(policy, indent=2), file=handle)
PYEOF
chown kiosk:kiosk /etc/chromium/policies/managed/policies.json
echo "[Hook] Generated boot-time Chromium policy from $POLICY_BASE."

#    The agent's enrolment config holds a device bearer token.
mkdir -p /etc/labkiosk
chown kiosk:kiosk /etc/labkiosk
chmod 700 /etc/labkiosk
mkdir -p /etc/labkiosk/system-connections
chmod 700 /etc/labkiosk/system-connections

# 3a. System clock in Asia/Kolkata (IST).
#
#     This is the image's default. live-config's 0070-tzdata component rewrites
#     /etc/timezone on every boot through live-boot and falls back to Etc/UTC
#     when nothing asks otherwise, so the ISO's boot menus pass
#     timezone=Asia/Kolkata as well. Change one and change the other, or the
#     live session will disagree with this file about the time.
#
#     An INSTALLED workstation also boots through live-boot now, but its menu
#     deliberately passes no timezone=: the organization's choice, saved in
#     localization.json on LABKIOSK_DATA, is what the agent re-applies at every
#     start, and a zone on the command line would only fight it.
#     systemd-timesyncd (in the package list) keeps the clock itself correct.
ln -snf /usr/share/zoneinfo/Asia/Kolkata /etc/localtime
echo "Asia/Kolkata" > /etc/timezone

# 4. Mask virtual terminals so Ctrl+Alt+F1..F6 cannot reach a login prompt.
for tty in 1 2 3 4 5 6; do
    systemctl mask "getty@tty${tty}.service" || true
done
systemctl mask serial-getty@.service || true
systemctl mask debug-shell.service || true

# No suspend or hibernation: a kiosk is on, or powered off or restarting
# (logind.conf.d/labkiosk.conf and sleep.conf.d/labkiosk.conf say why).
systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target \
    suspend-then-hibernate.target

# Mask NetworkManager-wait-online to prevent 120s boot stalls when network is offline/slow.
systemctl mask NetworkManager-wait-online.service || true

# 5. Stop the X server from switching VTs or being killed with Ctrl+Alt+Backspace.
#    Masked gettys hide the login prompt; this removes the escape itself.
#    The four *Time options are also the kiosk's only "never blank the screen"
#    setting: the Openbox autostart no longer runs xset.
mkdir -p /etc/X11/xorg.conf.d
cat << 'EOF' > /etc/X11/xorg.conf.d/10-kiosk-lockdown.conf
Section "ServerFlags"
    Option "DontVTSwitch" "true"
    Option "DontZap"      "true"
    Option "BlankTime"    "0"
    Option "StandbyTime"  "0"
    Option "SuspendTime"  "0"
    Option "OffTime"      "0"
EndSection
EOF

# 6. Allow the kiosk user to reboot and power off, and nothing else.
#    These are the only privileged actions the agent performs; without a rule it
#    runs as an unprivileged user and the operator's shutdown command silently
#    does nothing.
mkdir -p /etc/polkit-1/rules.d
cat << 'EOF' > /etc/polkit-1/rules.d/50-labkiosk-power.rules
polkit.addRule(function(action, subject) {
    if (subject.user !== "kiosk") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.reboot-multiple-sessions" ||
        action.id === "org.freedesktop.login1.power-off" ||
        action.id === "org.freedesktop.login1.power-off-multiple-sessions") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
EOF

# NetworkManager rights for the agent, which runs as kiosk and applies the setup
# wizard's network settings through nmcli. The post-install gate on who may
# *ask* the agent to change the network is the boot-menu password, which the
# agent enforces on /api/network/configure.
cat << 'EOF' > /etc/polkit-1/rules.d/50-labkiosk-network.rules
polkit.addRule(function(action, subject) {
    if (subject.user !== "kiosk") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
EOF

# Over-the-air updates (labkiosk-update, phase 3): the agent may start the two
# update units, and only start them. What they download is what the control
# plane offers and the image's own keys have signed; when they install is an
# administrator's decision, sent as a command. It may also stop
# labkiosk-share.service, which serves a downloaded release to the workstations
# at its site, when the organization stops sharing (phase 5); root starts it.
# No other unit, and no other verb, is granted.
cat << 'EOF' > /etc/polkit-1/rules.d/50-labkiosk-update.rules
polkit.addRule(function(action, subject) {
    if (subject.user !== "kiosk") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "start" &&
        (action.lookup("unit") === "labkiosk-update-download.service" ||
         action.lookup("unit") === "labkiosk-update-install.service")) {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "stop" &&
        action.lookup("unit") === "labkiosk-share.service") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
EOF

# Nothing else. The kiosk session is a logind session that is active on its
# seat, and polkit's defaults give such a user many rights a desktop user
# expects (the time zone, the hostname, mounting disks, ...). The rules above
# are the kiosk user's only ones; time zone and keyboard go through the one
# sudoers entry for labkiosk-localization below. Taking an inhibitor
# lock (keeping the screen on during a video) asks for nothing and stays open,
# as it was before the session was registered with logind.
cat << 'EOF' > /etc/polkit-1/rules.d/99-labkiosk-deny.rules
polkit.addRule(function(action, subject) {
    if (subject.user !== "kiosk") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id.indexOf("org.freedesktop.login1.inhibit-") === 0) {
        return polkit.Result.NOT_HANDLED;
    }
    return polkit.Result.NO;
});
EOF

# Sudoers permissions for the guided disk installer.
mkdir -p /etc/sudoers.d
cat << 'EOF' > /etc/sudoers.d/50-labkiosk-install
kiosk ALL=(ALL) NOPASSWD: /usr/local/bin/labkiosk-install
EOF
chmod 0440 /etc/sudoers.d/50-labkiosk-install

# Setting a timezone, generating a locale and writing /etc/default/keyboard all
# need root, and the agent deliberately does not run as root. One named program,
# which re-validates every argument against the system's own tables rather than
# trusting the caller -- the same rule the installer follows.
cat << 'EOF' > /etc/sudoers.d/51-labkiosk-localization
kiosk ALL=(ALL) NOPASSWD: /usr/local/sbin/labkiosk-localization
EOF
chmod 0440 /etc/sudoers.d/51-labkiosk-localization

# A power schedule's switch-on: the RTC wake alarm is root's to write. One
# named program, which takes a plain number of seconds within the next eight
# days, or `clear`, and writes /sys/class/rtc/rtc0/wakealarm and nothing else.
cat << 'EOF' > /etc/sudoers.d/52-labkiosk-wake-alarm
kiosk ALL=(ALL) NOPASSWD: /usr/local/sbin/labkiosk-wake-alarm
EOF
chmod 0440 /etc/sudoers.d/52-labkiosk-wake-alarm

# 7. Enable kiosk services.
systemctl set-default graphical.target
systemctl enable labkiosk-session.service
# Confirms a new system image after its one try, or reboots into the old one
# (labkiosk-boot-slots). A no-op off an installed disk.
systemctl enable labkiosk-boot-ok.service || true

# 7b. Logs and memory on an installed disk.
#
#     labkiosk-logs keeps the journal on LABKIOSK_DATA for seven days and
#     reports a boot that never shut down; labkiosk-swap adds the encrypted
#     swap partition behind compressed RAM (zram-generator needs no unit).
#     Both are no-ops on the live ISO.
systemctl enable labkiosk-logs.service
systemctl enable labkiosk-swap.service
#     No /var/log/journal in the image: journald then keeps the journal in
#     /run until labkiosk-logs binds the data partition's folder there and
#     flushes, so nothing from early boot is written to the RAM overlay and
#     lost. tmpfiles only adjusts this folder (z), it never creates it.
rm -rf /var/log/journal

# 7b2. The firewall: /etc/nftables.conf drops everything that arrives except
# replies, DHCP, neighbour discovery and ping. Not "|| true", and the file is
# checked to be ours: nftables ships its own, which filters nothing.
if ! grep -q '^table inet labkiosk_firewall {' /etc/nftables.conf; then
    echo "[Hook] ERROR: /etc/nftables.conf is not Lab Kiosk's firewall." >&2
    exit 1
fi
systemctl enable nftables.service

# 7b3. The clock from the network's own time servers (DHCP option 42), which
# NetworkManager's dispatcher hands to systemd-timesyncd: many organizations
# block the public NTP pool, and a clock minutes off breaks every HTTPS
# connection. NetworkManager only runs dispatcher scripts owned by root and
# writable by nobody else.
chown root:root /etc/NetworkManager/dispatcher.d/50-labkiosk-ntp
chmod 0755 /etc/NetworkManager/dispatcher.d/50-labkiosk-ntp
systemctl enable NetworkManager-dispatcher.service

# 7c. A hostname of each workstation's own, before the network comes up
# (labkiosk-hostname): stored at installation, or derived from the network card.
systemctl enable labkiosk-hostname.service
# 7d. On a machine with a TPM 2.0 chip the data partition is encrypted; this
# opens it with the chip before /etc/labkiosk is mounted, with nobody at the
# keyboard, and recreates it empty if the chip no longer releases the key
# (labkiosk-data-unlock). Elsewhere it does nothing.
systemctl enable labkiosk-data-unlock.service

# 7e. Disk health (labkiosk-health): SMART for SATA and NVMe, the card's own
# wear figures for eMMC, shortly after boot and every six hours, for the agent
# to report a disk that is wearing out. smartmontools' own daemon stays off:
# it would mail root, and there is nobody to read root's mail.
systemctl enable labkiosk-health.timer
systemctl disable smartmontools.service
systemctl mask smartmontools.service

# 7f. AppArmor profiles for the agent and x11vnc (/etc/apparmor.d/labkiosk-*),
# in complain mode: they block nothing yet, and log whatever the two do beyond
# them. The Debian kernel enables AppArmor; labkiosk-apparmor.service loads the
# two, because Debian's apparmor.service skips live systems and this one always
# runs from live-boot's overlay.
systemctl enable labkiosk-apparmor.service

# Configure Hyper-V & generic VM display/storage drivers in initramfs
mkdir -p /etc/initramfs-tools
cat << 'EOF' >> /etc/initramfs-tools/modules
hv_vmbus
hv_storvsc
hv_netvsc
hyperv_fb
hyperv_keyboard
EOF
update-initramfs -u || true


# 8a. Keep /etc/labkiosk writable by the agent, at every boot.
#
#     On an installed disk this path is the LABKIOSK_DATA partition. If it ever
#     ends up owned by root -- an older installer, a partition restored or
#     recreated by hand, a disk moved between machines -- the agent (which runs
#     as the unprivileged kiosk user) cannot save its enrolment, and the wizard
#     fails with "Permission denied" on a workstation that has no shell to fix it
#     from. Correcting it at boot costs nothing and makes that unrecoverable.
#
#     system-connections is deliberately left alone: NetworkManager keyfiles hold
#     Wi-Fi passphrases and must stay root-only.
cat << 'EOF' > /usr/local/sbin/labkiosk-data-permissions
#!/bin/sh
set -eu

DIR=/etc/labkiosk
KIOSK_UID="$(id -u kiosk)"
KIOSK_GID="$(id -g kiosk)"

# On an installed workstation this path IS the LABKIOSK_DATA partition, and
# everything else is an overlay in RAM. etc-labkiosk.mount mounts it "nofail",
# which means systemd does not order the boot behind it -- so it can still be
# unmounted when this runs. Creating a directory here in that moment is the
# worst outcome available: it looks writable, the agent enrols into it, and the
# enrolment is gone at the next power-off. Mount it instead of papering over it.
#
# Only the UUID GRUB passed as labkiosk.data= is this disk's data partition
# (labkiosk-data-generator says why it is never the label).
if grep -qsE '(^| )labkiosk\.installed=1( |$)' /proc/cmdline && ! mountpoint -q "$DIR"; then
    mkdir -p "$DIR"
    DATA_UUID="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^labkiosk\.data=//p' | tail -n 1)"
    if ! printf '%s\n' "$DATA_UUID" | grep -Eqx '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'; then
        echo "labkiosk: WARNING no valid labkiosk.data=<uuid> on the kernel command line; $DIR stays unmounted."
        echo "labkiosk: an enrolment made now would be forgotten at the next reboot."
        exit 0
    fi
    if mount -t ext4 "/dev/disk/by-uuid/$DATA_UUID" "$DIR" 2>/dev/null; then
        echo "labkiosk: mounted the persistent data partition at $DIR."
    else
        echo "labkiosk: WARNING $DIR is not the LABKIOSK_DATA partition and could not be mounted."
        echo "labkiosk: an enrolment made now would be forgotten at the next reboot."
        # Deliberately left as it is. An unwritable directory makes the agent
        # report something recoverable; a writable one in RAM silently loses
        # the organization's enrolment.
        exit 0
    fi
fi

mkdir -p "$DIR"

CURRENT="$(stat -c '%u:%g' "$DIR")"
if [ "$CURRENT" != "${KIOSK_UID}:${KIOSK_GID}" ]; then
    echo "labkiosk: $DIR was owned by $CURRENT; giving it to kiosk so the agent can enrol."
    chown "${KIOSK_UID}:${KIOSK_GID}" "$DIR"
fi
chmod 0700 "$DIR"

# The agent's own files; anything else (system-connections) keeps its ownership.
for _file in "$DIR"/config.json "$DIR"/proxy.json; do
    if [ -f "$_file" ]; then
        chown "${KIOSK_UID}:${KIOSK_GID}" "$_file"
        chmod 0600 "$_file"
    fi
done
exit 0
EOF
chmod 0755 /usr/local/sbin/labkiosk-data-permissions

cat << 'EOF' > /etc/systemd/system/labkiosk-data-permissions.service
[Unit]
Description=Ensure /etc/labkiosk is writable by the Lab Kiosk agent
# local-fs.target is where the LABKIOSK_DATA mount lands; labkiosk-session is
# what starts the session the agent runs in, so this has to be settled before either matters.
# etc-labkiosk.mount is named explicitly because it is "nofail": systemd then
# leaves that mount unordered against local-fs.target, so waiting for the
# target alone would not wait for the partition. On live media the generator
# creates no such unit, and ordering after a unit that does not exist is a no-op.
After=local-fs.target etc-labkiosk.mount
Before=labkiosk-session.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/labkiosk-data-permissions

[Install]
WantedBy=multi-user.target
EOF
systemctl enable labkiosk-data-permissions.service || true

# 8a'. Mount LABKIOSK_DATA on an installed disk.
#
#     The installed system boots the same squashfs as the ISO, so there is no
#     installer-written /etc/fstab any more (docs/OTA_UPDATES.md section 5.2).
#     etc-labkiosk.mount comes from labkiosk-data-generator
#     (/etc/systemd/system-generators), which pins it to the UUID on the
#     kernel command line; a static unit here would override it and must not
#     exist. A live session -- say, one booted to reinstall a machine -- gets
#     neither mount.
#     The bind mount is what makes NetworkManager's profiles, Wi-Fi keys
#     included, survive a reboot, so NetworkManager waits for it. It Requires
#     the generated unit, so without the data partition it does not happen.
NM_BIND_UNIT="$(systemd-escape --path --suffix=mount /etc/NetworkManager/system-connections)"
cat << 'EOF' > "/etc/systemd/system/$NM_BIND_UNIT"
[Unit]
Description=Lab Kiosk network profiles on the persistent data partition
ConditionKernelCommandLine=labkiosk.installed=1
Requires=etc-labkiosk.mount
After=etc-labkiosk.mount
Before=NetworkManager.service

[Mount]
What=/etc/labkiosk/system-connections
Where=/etc/NetworkManager/system-connections
Type=none
Options=bind,nofail

[Install]
WantedBy=local-fs.target
EOF
systemctl enable "$NM_BIND_UNIT" || true

# 8b. Ask for the installation USB stick to be removed before rebooting.
#
#     live-tools prints this for optical media, but bails out for USB mass
#     storage before it ever prompts (ejecting one needs a cold reboot). A USB
#     stick is exactly what organizations install from, so without this a freshly
#     installed workstation reboots straight back into the installer.
#
#     The guards match live-tools': nothing happens after toram, or when
#     noeject was passed. An installed disk boots through live-boot too, so its
#     boot menu passes noeject (which silences live-tools as well) and
#     labkiosk.installed=1, and either one is enough here -- an operator's
#     remote reboot of an enrolled workstation never waits for a keypress.
#     systemd runs these with a timeout, so an unattended machine continues on
#     its own rather than hanging forever.
mkdir -p /lib/systemd/system-shutdown
cat << 'EOF' > /lib/systemd/system-shutdown/labkiosk-medium.shutdown
#!/bin/sh
# Prompt to remove the live USB stick, the case live-tools skips.
if ! grep -qs "boot=live" /proc/cmdline; then
    exit 0
fi
if grep -qsE '(^| )labkiosk\.installed=1( |$)' /proc/cmdline; then
    exit 0
fi
if grep -qs "toram" /proc/cmdline || grep -qs "noeject" /proc/cmdline; then
    exit 0
fi

DEVICE="$(findmnt -Un -o source /run/live/medium 2>/dev/null | sed -e 's|^/dev/||')"
if [ -z "$DEVICE" ]; then
    exit 0
fi

# Only USB mass storage: live-tools has already prompted for anything else.
case "$DEVICE" in
    sd*) ;;
    *) exit 0 ;;
esac
PARENT="$(echo "$DEVICE" | sed -e 's/[0-9]*$//')"
if ! readlink "/sys/block/${PARENT}" | grep -q usb; then
    exit 0
fi

stty sane < /dev/console 2>/dev/null || true
printf "\n\nLab Kiosk: remove the installation USB stick, then press ENTER to continue:" > /dev/console
read _ignored < /dev/console || true
exit 0
EOF
chmod 0755 /lib/systemd/system-shutdown/labkiosk-medium.shutdown

# 10. Ship an empty /etc/machine-id.
#
#     Empty is systemd's "uninitialised" marker: every boot then generates an id
#     in RAM. The installer used to truncate the copy it rsynced onto the disk;
#     an installed disk now boots this very squashfs, so the image itself must
#     carry no id, or every workstation installed from it would share one.
: > /etc/machine-id

echo "[Hook] Lockdown configuration applied successfully."

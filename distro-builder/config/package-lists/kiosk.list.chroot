# The packages every architecture shares. The kernel, GRUB, microcode and the
# drivers that exist on one architecture only are in config/arch/<arch>/.

# Live Boot System
live-boot
live-config
live-config-systemd
# live-tools ships /lib/systemd/system-shutdown/live-tools.shutdown, which is what
# prints "Please remove the live-medium ... press ENTER" when a live session
# reboots. It is only a *Recommends* of live-boot, so it vanished when this build
# stopped installing recommends -- and a machine that had just been installed to
# disk rebooted straight back into the installer ISO. eject is what that script
# uses to open a real optical tray; without it the prompt still appears.
live-tools
eject
overlayroot
systemd-sysv
grub-common
grub2-common
efibootmgr
parted
dosfstools
e2fsprogs
rsync
sudo
# initramfs is xz-compressed (auto/config); without xz the rebuild fails.
xz-utils

# Hardware Firmware
# Listed explicitly: auto/config turns off live-build's "install every firmware
# package in the archive" default, which added ~875 MB of server-NIC, GPU-compute
# and Raspberry Pi blobs.
firmware-linux-free
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
# Desktop and laptop hardware beyond the reference Intel thin client: about 95 MB
# of the ISO. Server NICs (QLogic, Myricom, Cavium, Netronome) stay out; nothing
# a kiosk runs on carries them. Intel Arc (DG2) and NVIDIA nouveau firmware
# already come with firmware-misc-nonfree.
# AMD GPUs and APUs (amdgpu, radeon): without it they fall back to VESA.
firmware-amd-graphics
# Wi-Fi: Qualcomm Atheros, Broadcom, Marvell, TI, and USB dongles (ath9k_htc, ZyDAS).
firmware-atheros
firmware-ath9k-htc
firmware-brcm80211
firmware-libertas
firmware-ti-connectivity
firmware-zd1211
# Ethernet: Broadcom NetXtreme II, found in business desktops.
firmware-bnx2
firmware-bnx2x

# Minimal X11 Server, Drivers & Openbox
xserver-xorg-core
xserver-xorg-legacy
xserver-xorg-video-all
xserver-xorg-video-fbdev
xserver-xorg-video-vesa
xserver-xorg-input-all
# Hardware video decoding (VA-API) for Chromium, which otherwise decodes every
# video on the CPU. Mesa's OpenGL drivers (iris, radeonsi, nouveau) already come
# with the X server. mesa-va-drivers: AMD and Radeon (radeonsi, r600) and
# nouveau; Intel's drivers are in config/arch/amd64/.
mesa-va-drivers
# vainfo: the agent asks it once per boot which codecs the GPU decodes, and
# reports that next to the workstation in the admin console.
vainfo
# The kiosk session (labkiosk-session.service) is xinit run by the kiosk user,
# not a display manager; pam_systemd registers it with logind, which is what
# lets the X server run without root.
xinit
libpam-systemd
openbox
xdotool
scrot
unclutter
alsa-utils

# Chromium Browser & Educational Fonts
chromium
chromium-sandbox
fonts-dejavu
fonts-liberation
fonts-noto-core
fonts-noto-color-emoji
# Chinese, Japanese and Korean, which fonts-noto-core does not cover: without
# them those pages show empty boxes. Fonts have to be in the image, because the
# root file system is read-only and updates replace it whole.
fonts-noto-cjk

# Remote Management & Networking
x11vnc
network-manager
# Recommends-only; the kiosk needs a correct clock for TLS and the ip tool.
systemd-timesyncd
# The locale definitions the setup wizard's Language & Region step generates
# from (~21 MB). Not locales-all, which is 350 MB of pre-generated locales for
# languages no single organization uses: labkiosk-localization generates the one that
# was chosen, in about three megabytes, at installation time.
locales
iproute2
libnss-systemd
wpasupplicant
wireless-regdb
rfkill
curl
python3
# labkiosk-update verifies the signature of every system image it downloads with
# gpgv. apt depends on it today, but the update path must not rest on that.
gpgv
# The firewall (/etc/nftables.conf, loaded by nftables.service): nothing from
# the network gets an answer but replies, DHCP, neighbour discovery and ping.
# Sharing a system update on the local network (labkiosk-share.service) adds the
# rule that keeps its port to private addresses.
nftables
# Compressed RAM as the first swap (/etc/systemd/zram-generator.conf), and the
# installed disk's swap partition, encrypted with a key for one boot only
# (labkiosk-swap).
systemd-zram-generator
cryptsetup-bin
# The data partition's key, sealed to the TPM 2.0 chip (labkiosk-data-unlock):
# systemd-cryptenroll and systemd-cryptsetup load these at run time.
libtss2-esys-3.0.2-0t64
libtss2-mu-4.0.1-0t64
libtss2-rc0t64
libtss2-tcti-device0t64
# Disk health (labkiosk-health): smartctl reads SATA and NVMe SMART data.
smartmontools
# AppArmor profiles for the agent and x11vnc (/etc/apparmor.d), loaded at boot
# by labkiosk-apparmor.service; the Debian kernel has AppArmor switched on already.
apparmor
# Printing, off until an administrator turns it on in Settings -> Printing
# (labkiosk-printing). Driverless IPP Everywhere only, to network printers the
# organization lists: no printer drivers, no ghostscript (cups-filters), no
# cups-browsed or avahi-daemon (no discovery; recommends are off), no ipp-usb
# (no USB printers). The image ships CUPS masked: nothing runs or listens.
#   cups-daemon                the scheduler, and the ipp/ipps backends
#   cups-client                lpadmin and lpstat, which labkiosk-printing runs
#   cups-filters-core-drivers  pdftopdf and pdftoraster: what an IPP Everywhere
#                              queue converts Chromium's PDF with
cups-daemon
cups-client
cups-filters-core-drivers
# The agent's control channel: one WebSocket to the organization's hub. Without it
# the agent falls back to the 3-second HTTP heartbeat, which works but costs far more.
python3-websocket
ca-certificates

#!/bin/sh
set -e

# ---------------------------------------------------------------------------
# Boot-menu password for the *live* ISO.
#
# 02-security.hook.chroot installs /etc/grub.d/01_labkiosk_password, but that is
# only consumed by update-grub on an installed disk. The ISO's own menus come
# from config/bootloaders/, which the chroot hooks never touch -- so until this
# ran, a user could boot the USB, press `e`, append init=/bin/sh and get a
# root shell before a single one of this image's protections existed.
#
# The generated file only sets superusers/password_pbkdf2. Every menuentry in
# grub.cfg carries --unrestricted, so the machine still boots unattended with no
# prompt; the password is required only to edit an entry or open the GRUB shell.
#
# Legacy BIOS needs no equivalent: ALLOWOPTIONS 0 and NOESCAPE 1 in
# config/bootloaders/*/stdmenu.cfg make syslinux discard user-typed kernel
# arguments outright, which closes the same hole without a password.
#
# WHERE THE HASH COMES FROM, AND WHY grub.pin IS EMPTY IN GIT
# ----------------------------------------------------------
# LABKIOSK_GRUB_PBKDF2 in the build environment takes precedence, so a
# per-customer ISO can be produced without the hash ever entering the
# repository:
#
#   docker run --privileged --rm -e LABKIOSK_GRUB_PBKDF2="grub.pbkdf2.sha512..." \
#       -v "$PWD/distro-builder/out:/build/out" ghcr.io/akbhoi/labkiosk-iso-builder
#
# grub.pin remains as a fallback for a single organisation building its own
# image. Do NOT commit a hash there in a product shipped to more than one
# customer: one ISO would then carry one password shared by every deployment,
# a leak anywhere would compromise all of them, and it could not be rotated on
# machines already in the field. Installed workstations get a per-site password
# from the setup wizard instead (see labkiosk-install --grub-password-hash).
# ---------------------------------------------------------------------------
GRUB_PIN="config/includes.chroot/usr/share/labkiosk/grub.pin"
GRUB_PASSWORD_CFG="config/bootloaders/grub-pc/labkiosk-password.cfg"

rm -f "$GRUB_PASSWORD_CFG"

GRUB_PASSWORD_HASH="${LABKIOSK_GRUB_PBKDF2:-}"
GRUB_PASSWORD_SOURCE="the LABKIOSK_GRUB_PBKDF2 build environment variable"
if [ -z "$GRUB_PASSWORD_HASH" ] && [ -f "$GRUB_PIN" ]; then
    GRUB_PASSWORD_HASH="$(sed -n 's/^PASSWORD_PBKDF2=//p' "$GRUB_PIN" | tr -d '[:space:]')"
    GRUB_PASSWORD_SOURCE="$GRUB_PIN"
fi

if [ -z "$GRUB_PASSWORD_HASH" ]; then
    echo "[config] NOTE: no GRUB password supplied, so the LIVE ISO boot menu is editable."
    echo "[config] Set LABKIOSK_GRUB_PBKDF2 in the build environment to lock it."
    echo "[config] This does not affect installed workstations: the setup wizard collects"
    echo "[config] a per-site boot-menu password during disk installation."
elif ! printf '%s' "$GRUB_PASSWORD_HASH" | grep -q '^grub\.pbkdf2\.sha512\.'; then
    echo "[config] ERROR: the GRUB password from $GRUB_PASSWORD_SOURCE is not a" >&2
    echo "[config] grub-mkpasswd-pbkdf2 hash. Expected a value beginning" >&2
    echo "[config] 'grub.pbkdf2.sha512.'." >&2
    exit 1
else
    echo "[config] Applying GRUB boot-menu password from $GRUB_PASSWORD_SOURCE."
    cat > "$GRUB_PASSWORD_CFG" << EOF
# GENERATED by auto/config -- do not edit, and do not commit.
set superusers="labkiosk"
password_pbkdf2 labkiosk $GRUB_PASSWORD_HASH
EOF
fi

# ARCHITECTURE
# ------------
# The image is built for the architecture of the machine (or container) that
# builds it, natively: debootstrap and every chroot hook run that
# architecture's binaries. LABKIOSK_ARCH names it explicitly, and must then
# match, unless the host runs the other architecture's binaries through
# qemu-user (binfmt_misc), which works but takes several times longer.
#
# What differs per architecture is in config/arch/<arch>/: the packages
# (kernel flavour, GRUB, CPU microcode, GPU and VA-API drivers) and the boot
# loaders live-build puts on the ISO. auto/config copies the package list
# into config/package-lists/ for this build only; a file there for another
# architecture would make live-build install packages that do not exist.
LABKIOSK_ARCH="${LABKIOSK_ARCH:-$(dpkg --print-architecture)}"
ARCH_DIR="config/arch/$LABKIOSK_ARCH"
ARCH_PACKAGES="config/package-lists/arch.list.chroot"
if [ ! -f "$ARCH_DIR/packages.list.chroot" ] || [ ! -f "$ARCH_DIR/bootloaders" ]; then
    echo "[config] ERROR: no build definition for architecture '$LABKIOSK_ARCH'." >&2
    echo "[config] Supported: $(ls config/arch | tr '\n' ' ')" >&2
    echo "[config] See wiki/Building-for-Your-Platform.md to add one." >&2
    exit 1
fi
BOOTLOADERS="$(tr -d '[:space:]' < "$ARCH_DIR/bootloaders")"
cp "$ARCH_DIR/packages.list.chroot" "$ARCH_PACKAGES"
echo "[config] Building for $LABKIOSK_ARCH (boot loaders: $BOOTLOADERS)."

# IMAGE SIZE
# ----------
# --apt-recommends false: Recommends added printer tools, Samba, Avahi,
#   ModemManager and ~30 Perl web modules. The few recommended packages the kiosk
#   does rely on are listed by name in config/package-lists/kiosk.list.chroot.
# --firmware-chroot/--firmware-binary false: the default installs every package
#   from non-free-firmware (~875 MB installed). The firmware this image supports
#   is listed explicitly in the package list instead.
# The initrd is xz-compressed through initramfs-tools itself
# (includes.chroot/etc/initramfs-tools/conf.d/labkiosk-compress): live-build
# 20230502 only knows gzip/bzip2/lzma for --initramfs-compression and would
# silently keep gzip for anything else.
# /live/vmlinuz and /live/initrd.img are hard links to the versioned files and
# xorriso stores them once, so they cost nothing on the ISO.
# --chroot-squashfs-compression-type zstd: the system image is compressed with
#   zstd instead of live-build's default xz. mksquashfs compresses several times
#   faster, and every boot and every page the RAM overlay reads from the image
#   decompresses faster, for a somewhat larger image. Debian's kernel reads
#   zstd squashfs (CONFIG_SQUASHFS_ZSTD); the initrd stays xz (above).
lb config noauto \
    --apt-recommends false \
    --firmware-chroot false \
    --firmware-binary false \
    --mode debian \
    --system live \
    --distribution trixie \
    --parent-distribution trixie \
    --parent-debian-installer-distribution trixie \
    --archive-areas "main contrib non-free non-free-firmware" \
    --architectures "$LABKIOSK_ARCH" \
    --binary-images iso-hybrid \
    --bootloaders "$BOOTLOADERS" \
    --bootappend-live "boot=live components consoleblank=0 overlayroot=tmpfs:recurse=0 timezone=Asia/Kolkata username=kiosk" \
    --bootappend-live-failsafe "boot=live components nomodeset xforcevesa vga=791 overlayroot=tmpfs:recurse=0 timezone=Asia/Kolkata username=kiosk" \
    --compression gzip \
    --chroot-squashfs-compression-type zstd \
    --memtest none \
    --iso-application "Lab Kiosk OS" \
    --iso-publisher "Lab Kiosk" \
    --iso-volume "LAB_KIOSK" \
    "${@}"

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labkiosk-controller",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "labkiosk-db",
      "database_id": "labkiosk_db_id",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

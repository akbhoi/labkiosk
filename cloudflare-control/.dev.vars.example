# Local secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and edit.
#
# With a D1 binding present the worker refuses to seed the well-known default
# super admin, so these two are required even locally. The test suite and the
# in-memory database (ALLOW_LOCAL_DB=1) are the only places a default is used.
SUPER_ADMIN_EMAIL=admin@example.edu
SUPER_ADMIN_PASSWORD=change-me-before-first-run-2026

# Optional: public URL of a built ISO to link from the landing page.
# ISO_DOWNLOAD_URL=https://example.org/labkiosk-debian12-amd64.iso

# Optional: Apex domain used for subdomain routing (defaults to labkiosk.akbhoi.com).
# DEFAULT_DOMAIN=labkiosk.akbhoi.com


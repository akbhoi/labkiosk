# Local secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and edit:
#   cp .dev.vars.example .dev.vars
#
# `pnpm dev` listens on 0.0.0.0 so the workstation simulator can reach it by LAN
# address, which means anyone on that network can reach the sign-in page too.
# Choose your own super admin password; never reuse the well-known local default.
SUPER_ADMIN_EMAIL=admin@example.edu
SUPER_ADMIN_PASSWORD=change-me-before-first-run-2026

# Local development only: lets the worker create its own tables and seed the
# super admin above. `pnpm dev` passes it already; a deployed worker must never
# have it set, because it also switches off the production schema check.
ALLOW_LOCAL_DB=1

# Optional: apex domain used for subdomain routing (defaults to labkiosk.org).
# DEFAULT_DOMAIN=labkiosk.org

# Optional: turns on automatic Remote Control tunnels (src/remote_tunnels.ts).
# 32 random bytes, base64:  openssl rand -base64 32
# REMOTE_TUNNEL_KEY=
# Optional, with it: the platform's remote-control domain for organizations without
# one (DEFAULT_DOMAIN itself or a zone of its own, never under it). See docs/DEPLOYMENT.md.
# REMOTE_TUNNEL_PLATFORM_DOMAIN=
# REMOTE_TUNNEL_PLATFORM_ACCOUNT_ID=
# REMOTE_TUNNEL_PLATFORM_ZONE_ID=
# REMOTE_TUNNEL_PLATFORM_TOKEN=
# REMOTE_TUNNEL_PLATFORM_ACCESS_CLIENT_ID=
# REMOTE_TUNNEL_PLATFORM_ACCESS_CLIENT_SECRET=

# Optional: public URL of a built ISO to link from the landing page.
# ISO_DOWNLOAD_URL=https://example.org/labkiosk-debian12-amd64.iso

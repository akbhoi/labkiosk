# Root build context. docker-test/Dockerfile is built from here (see
# docker-test/README.md), so without this the whole repository is sent to the
# daemon -- including the live-build working tree and every ISO ever produced,
# well over a gigabyte, plus a directory of dangling symlinks that the daemon
# cannot tar and reports as errors.

# live-build working directories and outputs.
distro-builder/.build/
distro-builder/cache/
distro-builder/chroot/
distro-builder/local/
distro-builder/binary/
distro-builder/out/
*.iso
*.iso.sha256
*.iso.zsync
*.img

# Generated by `lb config`; regenerated on every build.
distro-builder/config/binary
distro-builder/config/bootstrap
distro-builder/config/chroot
distro-builder/config/common
distro-builder/config/source
distro-builder/config/package-lists/live.list.chroot
distro-builder/config/hooks/normal/
distro-builder/config/hooks/live/0010-disable-kexec-tools.hook.chroot
distro-builder/config/hooks/live/0050-disable-sysvinit-tmpfs.hook.chroot
distro-builder/config/bootloaders/grub-pc/labkiosk-password.cfg

# Control plane: nothing in the simulator image needs it.
cloudflare-control/node_modules/
cloudflare-control/.wrangler/
cloudflare-control/.dev.vars
node_modules/
.pnpm-store/

# Python bytecode for the wrong interpreter.
__pycache__/
*.py[cod]

# VCS, editor and CI noise.
.git/
.github/
.idea/
.vscode/
*.swp
*~
